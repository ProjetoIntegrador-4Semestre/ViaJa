<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Viaja" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">@font/plus_jakarta_sans_regular</item>
        <item name="fontFamily">@font/plus_jakarta_sans_regular</item>
    </style>

    <style name="Theme.Viaja" parent="Base.Theme.Viaja" />

    <!-- ===== BOTÕES ===== -->
    <style name="Widget.Viaja.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/viaja_green</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/viaja_radius_button</item>
        <item name="android:minHeight">@dimen/viaja_button_height</item>
    </style>

    <style name="Widget.Viaja.Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/viaja_text</item>
        <item name="strokeColor">@color/viaja_field_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">@dimen/viaja_radius_button</item>
        <item name="android:minHeight">@dimen/viaja_button_outline_height</item>
    </style>

    <!-- ===== INPUTS ===== -->
    <style name="Widget.Viaja.Input.Outlined" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/viaja_field_border</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="cornerRadius">@dimen/viaja_radius_input</item>
    </style>

    <!-- ===== CHIPS / PILLS ===== -->
    <style name="Widget.Viaja.Chip.Filter" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="chipBackgroundColor">@color/viaja_field_border</item>
        <item name="android:textColor">@color/viaja_text</item>
        <item name="cornerRadius">@dimen/viaja_radius_chip</item>
        <item name="chipMinHeight">36dp</item>
    </style>

    <style name="Widget.Viaja.Chip.Selected" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="chipBackgroundColor">@color/viaja_green</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/viaja_radius_chip</item>
        <item name="chipMinHeight">36dp</item>
    </style>

    <!-- ===== CARDS ===== -->
    <style name="Widget" />
    <style name="Widget.Viaja" />

    <style name="Widget.Viaja.Card">
        <item name="cardCornerRadius">@dimen/viaja_radius_card</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>

    <!-- ===== AVATAR ===== -->
    <style name="Widget.Viaja.Avatar" parent="">
        <item name="android:layout_width">@dimen/viaja_avatar_size</item>
        <item name="android:layout_height">@dimen/viaja_avatar_size</item>
        <item name="android:scaleType">centerCrop</item>
    </style>
</resources>