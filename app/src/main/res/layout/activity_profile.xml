<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/viaja_cream"
    android:id="@+id/profileRoot"
    tools:context=".ui.main.ProfileActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="12dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#DDEBE5"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:background="@drawable/bg_avatar_circle"
                        android:clipToOutline="true"
                        android:importantForAccessibility="no"
                        android:padding="19dp"
                        android:src="@drawable/ic_nav_profile"
                        android:tint="@color/viaja_green_dark" />

                    <TextView
                        android:id="@+id/tvProfileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/profile_traveler"
                        android:gravity="center"
                        tools:text="Victor D. Curtis"
                        android:textColor="#064B2B"
                        android:textSize="20sp"
                        app:fontFamily="@font/be_vietnam_pro_extrabold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/tvProfileRole"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_profile_chip"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:text="@string/profile_traveler"
                            android:textColor="@color/viaja_green_dark"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/tvProfileMode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_profile_chip_blue"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            tools:text="@string/profile_tourism"
                            android:textColor="#1763A5"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditProfile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginTop="18dp"
                        android:text="@string/profile_edit"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        app:backgroundTint="#00AD63"
                        app:cornerRadius="22dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="☷  Preferências de viagem"
                        android:textColor="#123D2B"
                        android:textSize="14sp"
                        app:fontFamily="@font/plus_jakarta_sans_bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/profile_preferences_description"
                        android:textColor="#666B68"
                        android:textSize="10sp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_preference_track"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="3dp">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnProfileTourism"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:layout_weight="1"
                            android:text="@string/profile_tourism"
                            android:textAllCaps="false"
                            android:textColor="#526043"
                            android:textSize="12sp"
                            app:cornerRadius="18dp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnProfileWork"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:layout_weight="1"
                            android:text="@string/profile_work"
                            android:textAllCaps="false"
                            android:textColor="#526043"
                            android:textSize="12sp"
                            app:cornerRadius="18dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/profile_interests"
                            android:textColor="#123D2B"
                            android:textSize="14sp"
                            app:fontFamily="@font/plus_jakarta_sans_bold" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEditInterests"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_edit_interests"
                            android:textColor="@color/viaja_green_dark"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvProfileInterestsStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:textColor="#666B68"
                        android:textSize="12sp"
                        tools:text="@string/profile_interests_empty" />
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/profileInterestChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:chipSpacingVertical="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#FFF0A6"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/subscription_current_plan"
                        android:textColor="#675317"
                        android:textSize="12sp"
                        app:fontFamily="@font/plus_jakarta_sans_bold" />

                    <TextView
                        android:id="@+id/profileSubscriptionPlan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:accessibilityLiveRegion="polite"
                        android:textColor="@color/viaja_text"
                        android:textSize="20sp"
                        app:fontFamily="@font/be_vietnam_pro_extrabold"
                        tools:text="@string/subscription_free" />

                    <TextView
                        android:id="@+id/profileSubscriptionPrice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/viaja_text"
                        android:textSize="15sp"
                        app:fontFamily="@font/plus_jakarta_sans_bold"
                        tools:text="@string/subscription_price_free" />

                    <TextView
                        android:id="@+id/profileSubscriptionDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="#554B36"
                        android:textSize="13sp"
                        tools:text="@string/subscription_summary_free" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnManageSubscription"
                        style="@style/Widget.Viaja.Button.Outline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minHeight="48dp"
                        android:text="@string/subscription_settings"
                        android:textAllCaps="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="18dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Informações da conta"
                        android:textColor="#123D2B"
                        android:textSize="14sp"
                        app:fontFamily="@font/plus_jakarta_sans_bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:id="@+id/tvProfileEmail"
                        android:text="Endereço de e-mail\nNão informado"
                        android:textColor="#666B68"
                        android:textSize="11sp" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="8dp" android:background="#F0F0ED" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:id="@+id/tvProfileStatus"
                        android:text="Status da conta\nVisitante"
                        android:textColor="@color/viaja_green"
                        android:textSize="10sp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnProfileOffline"
                        style="@style/Widget.Viaja.Button.Outline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/profile_offline"
                        android:textAllCaps="false"
                        android:textColor="#07563A" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnProfileTerms"
                        style="@style/Widget.Viaja.Button.Outline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp"
                        android:text="@string/terms_privacy_title"
                        android:textAllCaps="false" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnProfileLogout"
                        style="@style/Widget.Viaja.Button.Outline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Sair da conta"
                        android:textAllCaps="false"
                        android:textColor="#07563A"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
