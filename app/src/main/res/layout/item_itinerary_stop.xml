<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_marginTop="12dp"
    android:background="@drawable/vi_surface">
    <TextView
        android:id="@+id/itineraryPlaceName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Carregando lugar…"
        android:textColor="@color/vi_ink"
        android:textSize="18sp" />
    <TextView
        android:id="@+id/itineraryPlaceTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="@color/vi_muted"
        android:textSize="14sp" />
    <TextView
        android:id="@+id/itineraryPlaceNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="@color/vi_muted"
        android:textSize="14sp" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/itinerarySchedule"
        style="@style/Widget.Viaja.Journey.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Ajustar parada" />
</LinearLayout>
