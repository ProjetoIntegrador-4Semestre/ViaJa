<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/vi_canvas">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:id="@+id/expensesSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textSize="16sp"
            android:textColor="@color/vi_muted" />
        <TextView
            android:id="@+id/expensesStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textSize="14sp"
            android:textColor="@color/vi_warning" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/expensesRefresh"
            style="@style/Widget.Viaja.Journey.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Atualizar gastos" />
        <LinearLayout
            android:id="@+id/expensesSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/vi_surface">
            <TextView
                android:id="@+id/expensesTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text=""
                android:textSize="28sp"
                android:textColor="@color/vi_ink" />
            <TextView
                android:id="@+id/expensesBudget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text=""
                android:textSize="14sp"
                android:textColor="@color/vi_muted" />
            <TextView
                android:id="@+id/expensesBalance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text=""
                android:textSize="16sp"
                android:textColor="@color/vi_ink" />
            <TextView
                android:id="@+id/expensesCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text=""
                android:textSize="14sp"
                android:textColor="@color/vi_muted" />
            <TextView
                android:id="@+id/expensesRefunds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text=""
                android:textSize="14sp"
                android:textColor="@color/vi_muted" />
            <TextView
                android:id="@+id/expensesSummaryHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="O resumo considera toda a viagem. Reembolsos não alteram o total registrado."
                android:textSize="12sp"
                android:textColor="@color/vi_muted" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/expensesAdd"
            style="@style/Widget.Viaja.Journey.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Registrar despesa" />
        <LinearLayout
            android:id="@+id/expensesEditor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/vi_surface">
            <TextView
                android:id="@+id/expensesEditorTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Despesa"
                android:textSize="20sp"
                android:textColor="@color/vi_ink" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Descrição">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/expenseDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLength="160"
                    android:textColor="@color/vi_ink"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Valor em R$">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/expenseAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:maxLength="20"
                    android:textColor="@color/vi_ink"
                    android:importantForAutofill="no"
                    android:digits="0123456789,." />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Data · dd/mm/aaaa">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/expenseDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="date"
                    android:maxLength="10"
                    android:textColor="@color/vi_ink"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:id="@+id/expensesDateHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Você pode registrar gastos feitos antes da viagem."
                android:textSize="12sp"
                android:textColor="@color/vi_muted" />
            <TextView
                android:id="@+id/expensesCategoryLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Categoria"
                android:textSize="14sp"
                android:textColor="@color/vi_muted" />
            <Spinner
                android:id="@+id/expenseCategory"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:contentDescription="Categoria da despesa" />
            <TextView
                android:id="@+id/expensesReimbursementLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Reembolso informado"
                android:textSize="14sp"
                android:textColor="@color/vi_muted" />
            <Spinner
                android:id="@+id/expenseReimbursement"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:contentDescription="Estado do reembolso" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/expensesSave"
                style="@style/Widget.Viaja.Journey.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Salvar despesa" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/expensesCancel"
                style="@style/Widget.Viaja.Journey.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Cancelar edição" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/expensesFilter"
            style="@style/Widget.Viaja.Journey.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Todas as categorias" />
        <TextView
            android:id="@+id/expensesListStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textSize="14sp"
            android:textColor="@color/vi_muted" />
        <LinearLayout
            android:id="@+id/expensesRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
