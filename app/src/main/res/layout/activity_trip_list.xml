<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vi_canvas"
    android:orientation="vertical"
    android:paddingTop="8dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Suas próximas histórias"
            android:textColor="@color/vi_ink"
            android:textSize="24sp"
            android:fontFamily="@font/plus_jakarta_sans_bold" />
        <TextView
            android:id="@+id/tvTripListSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Carregando viagens…"
            android:textColor="@color/vi_muted"
            android:textSize="14sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddTrip"
            style="@style/Widget.Viaja.Journey.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Nova viagem" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_trips"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingVertical="12dp"
        android:clipToPadding="false" />
</LinearLayout>
