<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nova Viagem"
        android:textColor="@color/viaja_text"
        android:textSize="18sp"
        android:textStyle="bold"
        app:fontFamily="@font/be_vietnam_pro_extrabold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Dê um nome e escolha o modo desta viagem."
        android:textColor="@color/viaja_gray"
        android:textSize="14sp" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Viaja.Input.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Nome da viagem">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTripName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <Spinner
        android:id="@+id/spinnerTripCity"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:contentDescription="Destino da viagem" />

    <Spinner
        android:id="@+id/spinnerTripMode"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:contentDescription="Modo da viagem" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelCreateTrip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Cancelar"
            android:textColor="@color/viaja_gray" />

        <Button
            android:id="@+id/btnConfirmCreateTrip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Criar"
            android:textColor="@color/white"
            android:backgroundTint="@color/viaja_green" />
    </LinearLayout>

</LinearLayout>
