<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/termsPrivacyRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/viaja_cream"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/termsPrivacyToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        app:navigationContentDescription="@string/terms_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/viaja_text"
        app:title="@string/terms_privacy_title"
        app:titleTextColor="@color/viaja_text" />

    <ScrollView
        android:id="@+id/termsPrivacyScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/termsPrivacyBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp" />
    </ScrollView>
</LinearLayout>
