<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/viaja_cream">

    <!-- Top Bar: Avatar, Brand "Viajá", Settings -->
    <ImageView
        android:id="@+id/ivExploreAvatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:contentDescription="Perfil"
        android:scaleType="centerCrop"
        android:src="@drawable/img_hero_beach"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/tvExploreBrand"
        android:layout_width="100dp"
        android:layout_height="38dp"
        android:contentDescription="Viajá"
        android:scaleType="fitCenter"
        android:src="@drawable/viaja_badge"
        app:layout_constraintBottom_toBottomOf="@id/ivExploreAvatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivExploreAvatar" />

    <ImageView
        android:id="@+id/btnExploreSettings"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Configurações"
        android:padding="8dp"
        android:src="@drawable/ic_settings"
        app:layout_constraintBottom_toBottomOf="@id/ivExploreAvatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivExploreAvatar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivExploreAvatar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Mode & AI Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipModeTurismo"
                    style="@style/Widget.Viaja.Chip.Selected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Turismo"
                    app:chipIcon="@drawable/ic_coffee"
                    app:chipIconTint="@color/white" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipModeTrabalho"
                    style="@style/Widget.Viaja.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Trabalho"
                    app:chipIcon="@drawable/ic_ac" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExploreAiChat"
                    style="@style/Widget.Viaja.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Falar com IA"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_star_fill"
                    app:iconSize="14dp" />
            </LinearLayout>

            <!-- Greeting -->
            <TextView
                android:id="@+id/tvExploreGreeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:text="Olá, Elena!"
                android:textColor="@color/viaja_text"
                android:textSize="26sp"
                android:textStyle="bold"
                app:fontFamily="@font/be_vietnam_pro_extrabold" />

            <TextView
                android:id="@+id/tvExploreSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                android:text="O sol já nasceu, onde vamos nos aventurar hoje?"
                android:textColor="@color/viaja_gray"
                android:textSize="14sp" />

            <!-- Search Bar & Filter Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilExploreSearch"
                    style="@style/Widget.Viaja.Input.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Para onde vamos?"
                    app:boxBackgroundColor="@color/white"
                    app:boxBackgroundMode="outline">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etExploreSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExploreFilter"
                    style="@style/Widget.Viaja.Button.Outline"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/viaja_green_light"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_filter"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/viaja_green"
                    app:strokeColor="@color/viaja_green_light" />
            </LinearLayout>

            <!-- Dropdown Filter Chips -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterType"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tipo ▾"
                    app:chipBackgroundColor="@color/white"
                    app:chipStrokeColor="@color/viaja_field_border"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterCountry"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="País ▾"
                    app:chipBackgroundColor="@color/white"
                    app:chipStrokeColor="@color/viaja_field_border"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterContinent"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Continente ▾"
                    app:chipBackgroundColor="@color/white"
                    app:chipStrokeColor="@color/viaja_field_border"
                    app:chipStrokeWidth="1dp" />
            </LinearLayout>

            <!-- Destination Cards (Hero + Vertical List matching Prototype) -->
            <!-- 1. Rio de Janeiro Hero Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardExploreRio"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Rio de Janeiro"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_hero_beach" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/overlay_dark" />

                    <!-- Badges -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="64dp"
                        android:background="@drawable/badge_circle"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="🔥 Popular"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="64dp"
                        android:layout_marginEnd="220dp"
                        android:background="@drawable/badge_circle"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="32°C"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvRioName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Rio de Janeiro"
                        android:textColor="@color/white"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/be_vietnam_pro_extrabold"
                        app:layout_constraintBottom_toTopOf="@id/tvRioSub"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tvRioSub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="12dp"
                        android:text="Descubra as maravilhas de um destinos turísticos mais populares do Brasil."
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        app:layout_constraintBottom_toTopOf="@id/btnExploreRioAction"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExploreRioAction"
                        style="@style/Widget.Viaja.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginBottom="16dp"
                        android:text="Explorar →"
                        android:textSize="13sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. São Paulo Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardExploreSp"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="São Paulo"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_hero_beach" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/overlay_dark" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginBottom="16dp"
                        android:text="São Paulo"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/be_vietnam_pro_extrabold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Amazonas Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardExploreAmazonas"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Amazonas"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_hero_beach" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/overlay_dark" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginBottom="16dp"
                        android:text="Amazonas"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/be_vietnam_pro_extrabold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Minas Gerais Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardExploreMinas"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Minas Gerais"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_hero_beach" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/overlay_dark" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginBottom="16dp"
                        android:text="Minas Gerais"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/be_vietnam_pro_extrabold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
