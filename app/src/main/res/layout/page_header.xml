<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/viaja_surface"
    android:minHeight="64dp">

    <ImageButton
        android:id="@+id/pageBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Voltar"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintBottom_toBottomOf="@id/pageLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/pageLogo" />

    <TextView
        android:id="@+id/pageTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        android:accessibilityHeading="true"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/viaja_text"
        android:textSize="16sp"
        app:fontFamily="@font/plus_jakarta_sans_bold"
        app:layout_constraintBottom_toBottomOf="@id/pageLogo"
        app:layout_constraintEnd_toStartOf="@id/pageLogo"
        app:layout_constraintStart_toEndOf="@id/pageBack"
        app:layout_constraintTop_toTopOf="@id/pageLogo"
        app:layout_goneMarginStart="16dp" />

    <ImageView
        android:id="@+id/pageLogo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginVertical="8dp"
        android:contentDescription="Viajá"
        android:scaleType="fitCenter"
        android:src="@drawable/viaja_circle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/pageAi"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Conversar com a Vi"
        android:padding="3dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ai_icon"
        app:layout_constraintBottom_toBottomOf="@id/pageLogo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/pageLogo" />
</androidx.constraintlayout.widget.ConstraintLayout>
