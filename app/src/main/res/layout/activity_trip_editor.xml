<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/vi_canvas">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Os detalhes que dão forma à viagem"
            android:textColor="@color/vi_ink"
            android:textSize="23sp"
            android:fontFamily="@font/plus_jakarta_sans_bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Comece pelo destino. Datas e orçamento podem ficar para depois."
            android:textColor="@color/vi_muted"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/tripEditorError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="@color/vi_warning"
            android:textSize="14sp"
            android:accessibilityLiveRegion="polite" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/tripEditorRetry"
            style="@style/Widget.Viaja.Journey.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tentar novamente" />
        <LinearLayout
            android:id="@+id/tripEditorFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Nome da viagem"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tripEditorName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:hint=""
                    android:textColor="@color/vi_ink"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="DESTINO"
                android:textColor="@color/vi_muted"
                android:textSize="11sp" />
            <Spinner
                android:id="@+id/tripEditorCity"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:contentDescription="Destino da viagem" />
            <TextView
                android:id="@+id/tripEditorCityHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text=""
                android:textColor="@color/vi_muted"
                android:textSize="14sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="MODO"
                android:textColor="@color/vi_muted"
                android:textSize="11sp" />
            <Spinner
                android:id="@+id/tripEditorMode"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:contentDescription="Modo da viagem" />
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Início · opcional"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tripEditorStart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="date"
                    android:maxLines="1"
                    android:hint="dd/mm/aaaa"
                    android:textColor="@color/vi_ink"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Fim · opcional"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tripEditorEnd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="date"
                    android:maxLines="1"
                    android:hint="dd/mm/aaaa"
                    android:textColor="@color/vi_ink"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Toque nas datas para abrir o calendário. Apague para deixar sem data. Alterar o início desloca as datas das paradas, mantendo o número de cada dia."
                android:textColor="@color/vi_muted"
                android:textSize="14sp" />
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Orçamento total em R$ · opcional"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tripEditorBudget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:digits="0123456789,."
                    android:maxLength="20"
                    android:maxLines="1"
                    android:hint="2500,00"
                    android:textColor="@color/vi_ink"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Este valor é seu limite planejado, não uma despesa registrada."
                android:textColor="@color/vi_muted"
                android:textSize="14sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/tripEditorSave"
                style="@style/Widget.Viaja.Journey.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Salvar viagem" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
