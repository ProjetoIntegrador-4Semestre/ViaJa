<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/viaja_cream"
    android:orientation="vertical"
    android:padding="16dp">
    <TextView android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Encontre seu próximo destino"
        android:textColor="#07563A"
        android:textSize="23sp"
        app:fontFamily="@font/plus_jakarta_sans_bold" />

    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.Viaja.Input.Outlined"
        android:layout_marginTop="12dp"
        android:hint="Buscar cidade ou lugar">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etExploreSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton android:id="@+id/btnExploreSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Buscar lugares"
        style="@style/Widget.Viaja.Button.Primary"
        app:backgroundTint="#07563A"
        android:textColor="@color/white" />

    <TextView android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:text="Destinos"
        android:textColor="#07563A"
        android:textSize="18sp"
        app:fontFamily="@font/plus_jakarta_sans_bold" />

    <TextView android:id="@+id/exploreCityStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Carregando destinos…"
        android:textColor="#53675A"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButton android:id="@+id/exploreRetry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Tentar novamente"
        style="@style/Widget.Viaja.Button.Outline"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/exploreCities"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />
</LinearLayout>
