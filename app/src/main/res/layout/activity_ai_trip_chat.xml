<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/vi_canvas">
    <LinearLayout
        android:id="@+id/viHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">
        <ImageButton
            android:id="@+id/viBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/vi_ink"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voltar" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="0dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vi"
                android:textColor="@color/vi_ink"
                android:textSize="24sp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:accessibilityHeading="true" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sua viagem, com mais possibilidades"
                android:textColor="@color/vi_muted"
                android:textSize="11sp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/viMenu"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:text="Opções"
            android:textColor="@color/vi_primary"
            android:contentDescription="Opções da conversa" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="8dp"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@drawable/vi_context">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONTEXTO DA CONVERSA"
                android:textSize="10sp"
                android:letterSpacing="0.08"
                android:textColor="@color/vi_muted" />
            <TextView
                android:id="@+id/tvAiContext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/vi_ink"
                android:textSize="15sp"
                android:fontFamily="@font/plus_jakarta_sans_bold" />
            <TextView
                android:id="@+id/viContextDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/vi_muted"
                android:textSize="12sp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/tvAiEditContext"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Ajustar"
            android:textColor="@color/vi_primary" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_ai_chat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp" />
    <HorizontalScrollView
        android:id="@+id/viSuggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="16dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/viSuggestPlan"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Planejar meus dias"
                android:textColor="@color/vi_primary"
                app:strokeColor="@color/vi_border"
                app:cornerRadius="24dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/viSuggestBudget"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="Viajar gastando menos"
                android:textColor="@color/vi_primary"
                app:strokeColor="@color/vi_border"
                app:cornerRadius="24dp" />
        </LinearLayout>
    </HorizontalScrollView>
    <TextView
        android:id="@+id/viServiceStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingVertical="8dp"
        android:text="IA ainda não conectada. Você pode preparar seus pedidos aqui."
        android:textColor="@color/vi_warning"
        android:textSize="12sp"
        android:accessibilityLiveRegion="polite" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:padding="6dp"
        android:gravity="bottom"
        android:background="@drawable/vi_surface">
        <EditText
            android:id="@+id/etAiInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:maxHeight="144dp"
            android:padding="12dp"
            android:background="@null"
            android:hint="O que vamos planejar?"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="2000"
            android:imeOptions="flagNoExtractUi"
            android:textColor="@color/vi_ink"
            android:textColorHint="@color/vi_muted"
            android:textSize="15sp"
            android:importantForAutofill="no" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAiSend"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:backgroundTint="@color/vi_primary"
            android:contentDescription="Guardar pedido ainda não enviado"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_arrow_right"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/white" />
    </LinearLayout>
    <TextView
        android:id="@+id/viPrivacy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingBottom="12dp"
        android:textColor="@color/vi_muted"
        android:textSize="11sp" />
</LinearLayout>
