<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/viaja_cream">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarAiChat"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/viaja_cream"
        android:title="Vi — Assistente Viaja"
        android:titleTextColor="@color/viaja_text"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvAiContext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:text="Rio de Janeiro, BR · 3 dias ativos"
        android:textColor="@color/viaja_gray"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarAiChat" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tvAiContext">

        <com.google.android.material.chip.Chip
            style="@style/Widget.Viaja.Chip.Selected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Turismo" />

        <com.google.android.material.chip.Chip
            style="@style/Widget.Viaja.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Trabalho" />

        <TextView
            android:id="@+id/tvAiEditContext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Alterar"
            android:textColor="@color/viaja_green"
            android:textSize="12sp"
            app:fontFamily="@font/plus_jakarta_sans_bold" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_ai_chat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:stackFromEnd="true"
        app:reverseLayout="true"
        app:layout_constraintTop_toBottomOf="@id/tvAiEditContext"
        app:layout_constraintBottom_toTopOf="@id/inputAiChat" />

    <LinearLayout
        android:id="@+id/inputAiChat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_bar">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/Widget.Viaja.Input.Outlined"
            android:hint="Peça ajuda para a sua viagem">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAiInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAiSend"
            style="@style/Widget.Viaja.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:icon="@drawable/ic_arrow_right"
            android:text=""
            app:iconSize="20sp" />

    </LinearLayout>

    <include
        android:id="@+id/bottom_nav_bar"
        layout="@layout/bottom_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
