<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginVertical="8dp"
    android:padding="20dp"
    android:background="@drawable/vi_surface"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical">
    <TextView
        android:id="@+id/chipTripMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="@color/vi_primary"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/tv_trip_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="@color/vi_ink"
        android:textSize="20sp"
        android:fontFamily="@font/plus_jakarta_sans_bold" />
    <TextView
        android:id="@+id/tvTripDates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="@color/vi_muted"
        android:textSize="14sp" />
    <TextView
        android:id="@+id/tvTripBudget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="@color/vi_ink"
        android:textSize="15sp" />
    <TextView
        android:id="@+id/tripCardStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="@color/vi_muted"
        android:textSize="12sp" />
</LinearLayout>
