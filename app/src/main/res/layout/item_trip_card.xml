<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white"
    android:layout_marginStart="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="12dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/imgTrip"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:contentDescription="Trip image"
            android:scaleType="centerCrop"
            android:src="@drawable/img_hero_beach"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipTripMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Turismo"
            app:layout_constraintTop_toBottomOf="@id/imgTrip"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_trip_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Rio de Janeiro, BR"
            android:textColor="@color/viaja_text"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/chipTripMode"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnTripFavorite" />

        <TextView
            android:id="@+id/tvTripDates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="05 - 12 Out"
            android:textColor="@color/viaja_gray"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/tv_trip_name"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/btnTripFavorite"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="4dp"
            android:contentDescription="Favorite"
            android:src="@drawable/ic_heart"
            app:layout_constraintTop_toBottomOf="@id/tvTripDates"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvTripBudget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="R$ 2.400"
            android:textColor="@color/viaja_text"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tvTripDates"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
