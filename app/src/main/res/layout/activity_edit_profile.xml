<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/viaja_cream">

    <ImageView
        android:id="@+id/ivAvatar"
        android:layout_width="@dimen/viaja_avatar_size"
        android:layout_height="@dimen/viaja_avatar_size"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:contentDescription="Foto de perfil"
        android:scaleType="centerCrop"
        android:src="@drawable/img_hero_beach"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="16dp"
        android:text="Toque para alterar a foto"
        android:textColor="@color/viaja_gray"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@id/ivAvatar"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivAvatar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="@dimen/viaja_radius_card"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center_horizontal"
                        android:contentDescription="Foto de perfil"
                        android:src="@drawable/ic_launcher_foreground" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:text="Toque para alterar a foto"
                        android:textColor="@color/viaja_gray"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Nome completo"
                        android:textColor="@color/viaja_text"
                        android:textSize="14sp"
                        app:fontFamily="@font/plus_jakarta_sans_bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Viaja.Input.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:hint="Elena Rodriguez">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEditName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="E-mail"
                        android:textColor="@color/viaja_text"
                        android:textSize="14sp"
                        app:fontFamily="@font/plus_jakarta_sans_bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Viaja.Input.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:hint="elena.rodriguez@example.com">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEditEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Telefone"
                        android:textColor="@color/viaja_text"
                        android:textSize="14sp"
                        app:fontFamily="@font/plus_jakarta_sans_bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Viaja.Input.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:hint="(11) 98765-4321">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEditPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="phone" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Sobre você (Opcional)"
                        android:textColor="@color/viaja_text"
                        android:textSize="14sp"
                        app:fontFamily="@font/plus_jakarta_sans_bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Viaja.Input.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:hint="Conte um pouco sobre suas viagens...">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEditBio"
                            android:layout_width="match_parent"
                            android:layout_height="80dp"
                            android:inputType="textMultiLine" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveProfile"
                        style="@style/Widget.Viaja.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Salvar alterações" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>