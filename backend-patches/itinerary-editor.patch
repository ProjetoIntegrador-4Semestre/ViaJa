@@ -0,0 +1,135 @@
+package com.senac.viajaapi;
+
+import java.time.LocalTime;
+import java.time.temporal.ChronoUnit;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Set;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.*;
+import org.springframework.web.server.ResponseStatusException;
+
+import io.swagger.v3.oas.annotations.Operation;
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.NotNull;
+import jakarta.validation.constraints.Pattern;
+import jakarta.validation.constraints.Size;
+
+@RestController
+@RequestMapping("/trips/{tripId}/itinerary")
+public class ItineraryController {
+    private final TripAccess access;
+    private final TripLocalRepository stops;
+    private final TripMemoRepository memos;
+    private final LocalRepository places;
+
+    public ItineraryController(TripAccess access, TripLocalRepository stops, TripMemoRepository memos, LocalRepository places) {
+        this.access = access;
+        this.stops = stops;
+        this.memos = memos;
+        this.places = places;
+    }
+
+    @GetMapping
+    @Operation(summary = "Consultar roteiro editável")
+    public List<TripLocal> get(@PathVariable Long tripId) {
+        access.requireOwner(tripId);
+        return stops.findById_TripIdOrderByDayAscOrderIndexAsc(tripId);
+    }
+
+    @GetMapping("/places")
+    @Operation(summary = "Lugares da cidade para incluir no roteiro")
+    public List<PlaceOption> options(@PathVariable Long tripId) {
+        Trip trip = access.requireOwner(tripId);
+        return places.findByCityIdOrderByNameAsc(trip.getCityId()).stream()
+                .map(place -> new PlaceOption(place.getId(), place.getName())).toList();
+    }
+
+    public record PlaceOption(Long id, String name) { }
+
+    @PutMapping
+    @Transactional
+    @Operation(summary = "Salvar roteiro completo atomicamente", description = "Compara expected com o estado atual; conflito retorna 409. Uma repetição do mesmo estado final é idempotente. Remover uma parada também remove seus memos na mesma transação.")
+    public List<TripLocal> save(@PathVariable Long tripId, @Valid @RequestBody ItineraryRequest request) {
+        Trip trip = access.requireOwnerForUpdate(tripId);
+        List<TripLocal> current = stops.findById_TripIdOrderByDayAscOrderIndexAsc(tripId);
+        List<Stop> actual = current.stream().map(Stop::from).toList();
+        validate(trip, request.stops());
+        if (!same(actual, request.expected())) {
+            if (same(actual, request.stops())) return current;
+            throw new ResponseStatusException(HttpStatus.CONFLICT, "Itinerary changed; reload before saving");
+        }
+        Map<Long, TripLocal> existing = new HashMap<>();
+        for (TripLocal stop : current) existing.put(stop.getLocalId(), stop);
+        Set<Long> retained = new HashSet<>();
+        for (Stop item : request.stops()) {
+            Local place = places.findById(item.localId()).orElseThrow(() -> new IllegalArgumentException("Place does not exist"));
+            if (!Objects.equals(place.getCityId(), trip.getCityId())) throw new IllegalArgumentException("Place must belong to the trip city");
+            retained.add(item.localId());
+        }
+        for (TripLocal stop : current) {
+            if (!retained.contains(stop.getLocalId())) {
+                memos.deleteAll(memos.findByTripIdAndLocalId(tripId, stop.getLocalId()));
+                memos.flush();
+                stops.delete(stop);
+            }
+        }
+        stops.flush();
+        List<TripLocal> saved = new ArrayList<>();
+        for (Stop item : request.stops()) {
+            TripLocal stop = existing.get(item.localId());
+            if (stop == null) stop = new TripLocal(tripId, item.localId(), item.orderIndex(), item.day(), item.note());
+            stop.setDay(item.day());
+            stop.setOrderIndex(item.orderIndex());
+            stop.setNote(item.note());
+            stop.setScheduledTime(item.scheduledTime() == null ? null : LocalTime.parse(item.scheduledTime()));
+            stop.setCompleted(item.completed());
+            saved.add(stops.save(stop));
+        }
+        stops.flush();
+        return saved.stream().sorted(Comparator.comparing(TripLocal::getDay).thenComparing(TripLocal::getOrderIndex)).toList();
+    }
+
+    static boolean same(List<Stop> first, List<Stop> second) {
+        Comparator<Stop> order = Comparator.comparing(Stop::localId, Comparator.nullsFirst(Long::compareTo));
+        return first.stream().sorted(order).toList().equals(second.stream().sorted(order).toList());
+    }
+
+    static void validate(Trip trip, List<Stop> items) {
+        Set<Long> ids = new HashSet<>();
+        Map<Integer, Set<Integer>> orders = new HashMap<>();
+        Long duration = trip.getStartDate() != null && trip.getEndDate() != null
+                ? ChronoUnit.DAYS.between(trip.getStartDate(), trip.getEndDate()) + 1 : null;
+        for (Stop item : items) {
+            if (item == null || item.localId() == null || item.day() == null || item.day() < 1
+                    || item.orderIndex() == null || item.orderIndex() < 1 || item.completed() == null) throw new IllegalArgumentException("Invalid stop");
+            if (!ids.add(item.localId())) throw new IllegalArgumentException("Duplicate place in itinerary");
+            if (duration != null && item.day() > duration) throw new IllegalArgumentException("Day exceeds trip dates");
+            if (!orders.computeIfAbsent(item.day(), key -> new HashSet<>()).add(item.orderIndex())) throw new IllegalArgumentException("Duplicate order in day");
+        }
+        for (Set<Integer> indices : orders.values()) {
+            for (int index = 1; index <= indices.size(); index++) {
+                if (!indices.contains(index)) throw new IllegalArgumentException("Order must be contiguous within each day");
+            }
+        }
+    }
+
+    public record Stop(@NotNull Long localId, @NotNull Integer day, @NotNull Integer orderIndex, String note,
+            @Pattern(regexp = "(?:[01][0-9]|2[0-3]):[0-5][0-9]") String scheduledTime, @NotNull Boolean completed) {
+        static Stop from(TripLocal stop) {
+            return new Stop(stop.getLocalId(), stop.getDay(), stop.getOrderIndex(), stop.getNote(),
+                    stop.getScheduledTime() == null ? null : stop.getScheduledTime().format(java.time.format.DateTimeFormatter.ofPattern("HH:mm")), stop.isCompleted());
+        }
+    }
+
+    public record ItineraryRequest(@NotNull @Size(max = 1000) List<@NotNull @Valid Stop> expected,
+            @NotNull @Size(max = 1000) List<@NotNull @Valid Stop> stops) {
+    }
+}
