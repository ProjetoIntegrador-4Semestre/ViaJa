+package com.senac.viajaapi;
+import java.time.Instant;
+import java.util.*;
+import org.springframework.web.bind.annotation.*;
+import org.springframework.web.client.RestClient;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.server.ResponseStatusException;
+import tools.jackson.databind.JsonNode;
+@RestController
+@RequestMapping("/trips/{tripId}")
+public class TripResourcesController {
+    private final TripAccess access;
+    private final TripLocalRepository stops;
+    private final LocalRepository places;
+    private final TripNoteRepository notes;
+    private final TripMemoRepository memos;
+    private final TripChecklistRepository checklist;
+    private final TripExpenseController expenses;
+    private final Entitlements entitlements;
+    private final WeatherGateway forecast;
+    public TripResourcesController(TripAccess access,TripLocalRepository stops,LocalRepository places,TripNoteRepository notes,TripMemoRepository memos,TripChecklistRepository checklist,TripExpenseController expenses,Entitlements entitlements,WeatherGateway forecast){
+        this.access=access;
+        this.stops=stops;
+        this.places=places;
+        this.notes=notes;
+        this.memos=memos;
+        this.checklist=checklist;
+        this.expenses=expenses;
+        this.entitlements=entitlements;
+        this.forecast=forecast;
+    }
+    @GetMapping("/export") public TripBundle export(@PathVariable Long tripId,@RequestParam(defaultValue="false")boolean full){
+        var trip=access.requireOwner(tripId);
+        if(full)entitlements.requirePremium(trip.getUserId());
+        return bundle(trip,full);
+    }
+    @GetMapping("/offline") public TripBundle offline(@PathVariable Long tripId){
+        var trip=access.requireOwner(tripId);
+        entitlements.requirePremium(trip.getUserId());
+        return bundle(trip,true);
+    }
+    public TripBundle bundle(Trip trip,boolean full){
+        var entries=stops.findById_TripIdOrderByDayAscOrderIndexAsc(trip.getId()).stream().map(stop->{
+            var p=places.findById(stop.getLocalId()).orElse(null);
+            return new BundleStop(stop.getLocalId(),p==null?"Lugar indisponível":p.getName(),p==null?null:p.getAddress(),p==null||p.getLat()==null?null:p.getLat().doubleValue(),p==null||p.getLng()==null?null:p.getLng().doubleValue(),stop.getDay(),stop.getOrderIndex(),stop.getScheduledTime()==null?null:stop.getScheduledTime().toString(),stop.isCompleted(),full?stop.getNote():null);
+        }).toList();
+        var selectedMemos=full?entries.stream().flatMap(e->memos.findByTripIdAndLocalId(trip.getId(),e.localId()).stream()).map(m->new MemoView(m.getLocalId(),m.getNote())).toList():List.<MemoView>of();
+        return new TripBundle(1,trip.getUserId(),Instant.now().toString(),full,trip,entries,full?notes.findByTripId(trip.getId(),org.springframework.data.domain.Pageable.unpaged()).getContent():List.of(),selectedMemos,full?checklist.findByTripIdOrderByCreatedAtAscIdAsc(trip.getId()):List.of(),full?expenses.report(trip.getId()):null);
+    }
+    @GetMapping("/map") public List<BundleStop> map(@PathVariable Long tripId){
+        return bundle(access.requireOwner(tripId),false).stops();
+    }
+    private final java.util.concurrent.ConcurrentHashMap<Long,WeatherView> weatherCache=new java.util.concurrent.ConcurrentHashMap<>();
+    @GetMapping("/weather") public WeatherView weather(@PathVariable Long tripId){
+        var trip=access.requireOwner(tripId);
+        var cached=weatherCache.get(trip.getCityId());
+        if(cached!=null&&Instant.parse(cached.fetchedAt()).plusSeconds(900).isAfter(Instant.now()))return cached;
+        var point=places.findByCityIdOrderByNameAsc(trip.getCityId()).stream().filter(p->p.getLat()!=null&&p.getLng()!=null).findFirst().orElseThrow(()->new ResponseStatusException(HttpStatus.SERVICE_UNAVAILABLE,"Coordinates unavailable"));
+        var view=forecast.forecast(point.getLat().doubleValue(),point.getLng().doubleValue());
+        weatherCache.put(trip.getCityId(),view);
+        return view;
+    }
+    public record WeatherDay(String date,Double minimum,Double maximum,Integer code){
+    } public record WeatherView(String source,String fetchedAt,String timezone,List<WeatherDay> days){
+    }
+    public record BundleStop(Long localId,String name,String address,Double lat,Double lng,Integer day,Integer orderIndex,String time,boolean completed,String note){
+    }
+    public record MemoView(Long localId,String note){
+    }
+    public record TripBundle(int schemaVersion,Long ownerId,String downloadedAt,boolean full,Trip trip,List<BundleStop> stops,List<TripNote> notes,List<MemoView> memos,List<TripChecklistItem> checklist,TripExpenseController.ExpenseReport expenses){
+    }
+}
