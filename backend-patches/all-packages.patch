diff --git a/src/main/java/com/senac/viajaapi/GoogleLoginController.java b/src/main/java/com/senac/viajaapi/GoogleLoginController.java
new file mode 100644
--- /dev/null
+++ b/src/main/java/com/senac/viajaapi/GoogleLoginController.java
@@ -0,0 +1,67 @@
+package com.senac.viajaapi;
+import java.time.*;
+import java.util.*;
+import org.springframework.web.bind.annotation.*;
+import org.springframework.http.*;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.server.ResponseStatusException;
+@RestController @RequestMapping("/auth/google")
+public class GoogleLoginController {
+    private final GoogleAttemptRepository attempts;
+    private final GoogleOAuthGateway gateway;
+    private final UserRepository users;
+    private final JwtService jwt;
+    public GoogleLoginController(GoogleAttemptRepository attempts,GoogleOAuthGateway gateway,UserRepository users,JwtService jwt){
+        this.attempts=attempts;
+        this.gateway=gateway;
+        this.users=users;
+        this.jwt=jwt;
+    }
+    @PostMapping("/start") @Transactional public Start start(){
+        if(!gateway.configured())throw new ResponseStatusException(HttpStatus.SERVICE_UNAVAILABLE,"Google sign-in unavailable");
+        String state=RecoveryController.random(),poll=RecoveryController.random();
+        var row=new GoogleAttempt();
+        row.stateHash=RecoveryController.hash(state);
+        row.pollHash=RecoveryController.hash(poll);
+        row.nonce=RecoveryController.random();
+        row.verifier=RecoveryController.random();
+        row.expiresAt=Instant.now().plusSeconds(600);
+        attempts.save(row);
+        return new Start(gateway.authorization(state,row.nonce,row.verifier),poll);
+    }
+    @GetMapping("/callback") @Transactional public ResponseEntity<String> callback(@RequestParam String state,@RequestParam(required=false)String code,@RequestParam(required=false)String error){
+        var row=attempts.lockState(RecoveryController.hash(state)).orElseThrow(()->new IllegalArgumentException("Invalid sign-in state"));
+        if(row.ownerId!=null||row.consumed||!row.expiresAt.isAfter(Instant.now()))throw new IllegalArgumentException("Expired sign-in");
+        try{
+            if(error!=null||code==null)throw new IllegalArgumentException();
+            var identity=gateway.exchange(code,row.verifier,row.nonce);
+            var linked=users.findByGoogleId(identity.id());
+            var user=linked.orElseGet(()->users.findByEmail(identity.email()).orElse(null));
+            if(linked.isEmpty()&&user!=null&&!identity.authoritativeEmail())throw new IllegalArgumentException("Use password sign-in to link this Google identity");
+            if(user==null){
+                user=new User(identity.name().substring(0,Math.min(identity.name().length(),120)),identity.email(),null,"tourism",LocalDateTime.now(),LocalDateTime.now());
+                user.setAuthProvider(identity.authoritativeEmail()?"google":"google-external-email");
+            }if(user.getGoogleId()!=null&&!user.getGoogleId().equals(identity.id()))throw new IllegalArgumentException();
+            user.setGoogleId(identity.id());
+            user=users.saveAndFlush(user);
+            row.ownerId=user.getId();
+        }catch(Exception failure){
+            row.failed=true;
+        }attempts.save(row);
+        return ResponseEntity.ok().contentType(MediaType.TEXT_HTML).cacheControl(CacheControl.noStore()).header("Referrer-Policy","no-referrer").body("<!doctype html><meta name=viewport content='width=device-width'><title>Viajá</title><h1>Viajá</h1><p>Volte ao aplicativo para consultar o resultado da autenticação.</p>");
+    }
+    @PostMapping("/result") @Transactional public ResponseEntity<Session> result(@jakarta.validation.Valid @RequestBody Poll request){
+        var row=attempts.lockPoll(RecoveryController.hash(request.pollToken())).orElseThrow(()->new ResponseStatusException(HttpStatus.UNAUTHORIZED,"Invalid sign-in"));
+        if(row.consumed||row.failed||!row.expiresAt.isAfter(Instant.now()))throw new ResponseStatusException(HttpStatus.UNAUTHORIZED,"Sign-in expired or failed");
+        if(row.ownerId==null)return ResponseEntity.status(202).build();
+        row.consumed=true;
+        attempts.save(row);
+        var user=users.findById(row.ownerId).orElseThrow();
+        String token=jwt.generateToken(org.springframework.security.core.userdetails.User.withUsername(user.getEmail()).password("").authorities("ROLE_USER").build());
+        return ResponseEntity.ok(new Session(token,new UserResponse(user.getId(),user.getEmail(),user.getName(),user.getDefaultMode())));
+    }
+    public record Start(String authorizationUrl,String pollToken){
+    }public record Poll(@jakarta.validation.constraints.NotBlank @jakarta.validation.constraints.Size(max=200)String pollToken){
+    }public record Session(String token,UserResponse user){
+    }
+}
