+package com.senac.viajaapi;
+import java.util.*;
+import java.time.*;
+import java.security.*;
+import java.security.spec.*;
+import java.math.BigInteger;
+import java.nio.charset.StandardCharsets;
+import org.springframework.stereotype.Component;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.web.client.RestClient;
+import tools.jackson.databind.*;
+@Component public class GoogleOAuthGateway {
+    private final String clientId,secret,redirect;
+    private final ObjectMapper json;
+    private final RestClient http;
+    private Map<String,PublicKey> keys=Map.of();
+    private Instant keyExpires=Instant.EPOCH;
+    public GoogleOAuthGateway(@Value("${viaja.google.client-id:}")String clientId,@Value("${viaja.google.secret:}")String secret,@Value("${viaja.google.redirect:}")String redirect,ObjectMapper json){
+        this.clientId=clientId;
+        this.secret=secret;
+        this.redirect=redirect;
+        this.json=json;
+        var f=new org.springframework.http.client.JdkClientHttpRequestFactory(java.net.http.HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(5)).build());
+        f.setReadTimeout(Duration.ofSeconds(8));
+        http=RestClient.builder().requestFactory(f).build();
+    }
+    public boolean configured(){
+        return !clientId.isBlank()&&!secret.isBlank()&&redirect.startsWith("https://");
+    }
+    public String authorization(String state,String nonce,String verifier){
+        return org.springframework.web.util.UriComponentsBuilder.fromUriString("https://accounts.google.com/o/oauth2/v2/auth").queryParam("client_id",clientId).queryParam("redirect_uri",redirect).queryParam("response_type","code").queryParam("scope","openid email profile").queryParam("state",state).queryParam("nonce",nonce).queryParam("code_challenge",Base64.getUrlEncoder().withoutPadding().encodeToString(digest(verifier))).queryParam("code_challenge_method","S256").build().encode().toUriString();
+    }
+    private static byte[] digest(String value){
+        try{
+            return MessageDigest.getInstance("SHA-256").digest(value.getBytes(StandardCharsets.US_ASCII));
+        }catch(Exception e){
+            throw new IllegalStateException(e);
+        }
+    }
+    public Identity exchange(String code,String verifier,String nonce){
+        var form=new org.springframework.util.LinkedMultiValueMap<String,String>();
+        form.add("client_id",clientId);
+        form.add("client_secret",secret);
+        form.add("redirect_uri",redirect);
+        form.add("grant_type","authorization_code");
+        form.add("code",code);
+        form.add("code_verifier",verifier);
+        var result=http.post().uri("https://oauth2.googleapis.com/token").contentType(org.springframework.http.MediaType.APPLICATION_FORM_URLENCODED).body(form).retrieve().body(JsonNode.class);
+        if(result==null)throw new IllegalArgumentException("Invalid Google response");
+        return verify(result.path("id_token").asText(),nonce);
+    }
+    private synchronized PublicKey key(String kid)throws Exception{
+        if(Instant.now().isAfter(keyExpires)||!keys.containsKey(kid)){
+            var response=http.get().uri("https://www.googleapis.com/oauth2/v3/certs").retrieve().body(JsonNode.class);
+            var updated=new HashMap<String,PublicKey>();
+            if(response!=null)for(var item:response.path("keys")){
+                if(!"RSA".equals(item.path("kty").asText())||!"RS256".equals(item.path("alg").asText()))continue;
+                var n=new BigInteger(1,Base64.getUrlDecoder().decode(item.path("n").asText()));
+                var e=new BigInteger(1,Base64.getUrlDecoder().decode(item.path("e").asText()));
+                updated.put(item.path("kid").asText(),KeyFactory.getInstance("RSA").generatePublic(new RSAPublicKeySpec(n,e)));
+            }keys=updated;
+            keyExpires=Instant.now().plusSeconds(1800);
+        }var value=keys.get(kid);
+        if(value==null)throw new IllegalArgumentException("Unknown Google key");
+        return value;
+    }
+    public Identity verify(String token,String nonce){
+        try{
+            if(token.length()>20000)throw new IllegalArgumentException();
+            var parts=token.split("\\.");
+            if(parts.length!=3)throw new IllegalArgumentException();
+            var header=json.readTree(Base64.getUrlDecoder().decode(parts[0]));
+            if(!"RS256".equals(header.path("alg").asText()))throw new IllegalArgumentException();
+            var signature=Signature.getInstance("SHA256withRSA");
+            signature.initVerify(key(header.path("kid").asText()));
+            signature.update((parts[0]+"."+parts[1]).getBytes(StandardCharsets.US_ASCII));
+            if(!signature.verify(Base64.getUrlDecoder().decode(parts[2])))throw new IllegalArgumentException();
+            var claims=json.readTree(Base64.getUrlDecoder().decode(parts[1]));
+            boolean audience=claims.path("aud").isArray()?java.util.stream.StreamSupport.stream(claims.path("aud").spliterator(),false).anyMatch(v->clientId.equals(v.asText())):clientId.equals(claims.path("aud").asText());
+            if(!audience||claims.path("aud").isArray()&&!clientId.equals(claims.path("azp").asText())||!Set.of("accounts.google.com","https://accounts.google.com").contains(claims.path("iss").asText())||claims.path("exp").asLong()<=Instant.now().getEpochSecond()||claims.path("iat").asLong()>Instant.now().plusSeconds(60).getEpochSecond()||!nonce.equals(claims.path("nonce").asText())||!claims.path("email_verified").asBoolean()||claims.path("sub").asText().isBlank()||!claims.path("email").asText().contains("@")||claims.path("email").asText().length()>254)throw new IllegalArgumentException();
+            return new Identity(claims.path("sub").asText(),claims.path("email").asText().trim().toLowerCase(Locale.ROOT),claims.path("name").asText("Viajante"),claims.path("email").asText().toLowerCase(Locale.ROOT).endsWith("@gmail.com")||!claims.path("hd").asText().isBlank());
+        }catch(Exception failure){
+            throw new IllegalArgumentException("Invalid Google identity");
+        }
+    }
+    public record Identity(String id,String email,String name,boolean authoritativeEmail){
+    }
+}
diff --git a/src/main/java/com/senac/viajaapi/ItineraryController.java b/src/main/java/com/senac/viajaapi/ItineraryController.java
new file mode 100644
--- /dev/null
+++ b/src/main/java/com/senac/viajaapi/ItineraryController.java
@@ -0,0 +1,125 @@
+package com.senac.viajaapi;
+import java.time.LocalTime;
+import java.time.temporal.ChronoUnit;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Set;
+import org.springframework.http.HttpStatus;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.*;
+import org.springframework.web.server.ResponseStatusException;
+import io.swagger.v3.oas.annotations.Operation;
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.NotNull;
+import jakarta.validation.constraints.Pattern;
+import jakarta.validation.constraints.Size;
+@RestController
+@RequestMapping("/trips/{tripId}/itinerary")
+public class ItineraryController {
+    private final TripAccess access;
+    private final TripLocalRepository stops;
+    private final TripMemoRepository memos;
+    private final LocalRepository places;
+    public ItineraryController(TripAccess access, TripLocalRepository stops, TripMemoRepository memos, LocalRepository places) {
+        this.access = access;
+        this.stops = stops;
+        this.memos = memos;
+        this.places = places;
+    }
+    @GetMapping
+    @Operation(summary = "Consultar roteiro editável")
+    public List<TripLocal> get(@PathVariable Long tripId) {
+        access.requireOwner(tripId);
+        return stops.findById_TripIdOrderByDayAscOrderIndexAsc(tripId);
+    }
+    @GetMapping("/places")
+    @Operation(summary = "Lugares da cidade para incluir no roteiro")
+    public List<PlaceOption> options(@PathVariable Long tripId) {
+        Trip trip = access.requireOwner(tripId);
+        return places.findByCityIdOrderByNameAsc(trip.getCityId()).stream()
+        .map(place -> new PlaceOption(place.getId(), place.getName())).toList();
+    }
+    public record PlaceOption(Long id, String name) {
+    }
+    @PutMapping
+    @Transactional
+    @Operation(summary = "Salvar roteiro completo atomicamente", description = "Compara expected com o estado atual; conflito retorna 409. Uma repetição do mesmo estado final é idempotente. Remover uma parada também remove seus memos na mesma transação.")
+    public List<TripLocal> save(@PathVariable Long tripId, @Valid @RequestBody ItineraryRequest request) {
+        Trip trip = access.requireOwnerForUpdate(tripId);
+        List<TripLocal> current = stops.findById_TripIdOrderByDayAscOrderIndexAsc(tripId);
+        List<Stop> actual = current.stream().map(Stop::from).toList();
+        validate(trip, request.stops());
+        if (!same(actual, request.expected())) {
+            if (same(actual, request.stops())) return current;
+            throw new ResponseStatusException(HttpStatus.CONFLICT, "Itinerary changed; reload before saving");
+        }
+        Map<Long, TripLocal> existing = new HashMap<>();
+        for (TripLocal stop : current) existing.put(stop.getLocalId(), stop);
+        Set<Long> retained = new HashSet<>();
+        for (Stop item : request.stops()) {
+            Local place = places.findById(item.localId()).orElseThrow(() -> new IllegalArgumentException("Place does not exist"));
+            if (!Objects.equals(place.getCityId(), trip.getCityId())) throw new IllegalArgumentException("Place must belong to the trip city");
+            retained.add(item.localId());
+        }
+        for (TripLocal stop : current) {
+            if (!retained.contains(stop.getLocalId())) {
+                memos.deleteAll(memos.findByTripIdAndLocalId(tripId, stop.getLocalId()));
+                memos.flush();
+                stops.delete(stop);
+            }
+        }
+        stops.flush();
+        List<TripLocal> saved = new ArrayList<>();
+        for (Stop item : request.stops()) {
+            TripLocal stop = existing.get(item.localId());
+            if (stop == null) stop = new TripLocal(tripId, item.localId(), item.orderIndex(), item.day(), item.note());
+            stop.setDay(item.day());
+            stop.setOrderIndex(item.orderIndex());
+            stop.setNote(item.note());
+            stop.setScheduledTime(item.scheduledTime() == null ? null : LocalTime.parse(item.scheduledTime()));
+            stop.setCompleted(item.completed());
+            saved.add(stops.save(stop));
+        }
+        stops.flush();
+        return saved.stream().sorted(Comparator.comparing(TripLocal::getDay).thenComparing(TripLocal::getOrderIndex)).toList();
+    }
+    static boolean same(List<Stop> first, List<Stop> second) {
+        Comparator<Stop> order = Comparator.comparing(Stop::localId, Comparator.nullsFirst(Long::compareTo));
+        return first.stream().sorted(order).toList().equals(second.stream().sorted(order).toList());
+    }
+    static void validate(Trip trip, List<Stop> items) {
+        Set<Long> ids = new HashSet<>();
+        Map<Integer, Set<Integer>> orders = new HashMap<>();
+        Long duration = trip.getStartDate() != null && trip.getEndDate() != null
+        ? ChronoUnit.DAYS.between(trip.getStartDate(), trip.getEndDate()) + 1 : null;
+        for (Stop item : items) {
+            if (item == null || item.localId() == null || item.day() == null || item.day() < 1
+            || item.orderIndex() == null || item.orderIndex() < 1 || item.completed() == null) throw new IllegalArgumentException("Invalid stop");
+            if (!ids.add(item.localId())) throw new IllegalArgumentException("Duplicate place in itinerary");
+            if (duration != null && item.day() > duration) throw new IllegalArgumentException("Day exceeds trip dates");
+            if (!orders.computeIfAbsent(item.day(), key -> new HashSet<>()).add(item.orderIndex())) throw new IllegalArgumentException("Duplicate order in day");
+        }
+        for (Set<Integer> indices : orders.values()) {
+            for (int index = 1;
+            index <= indices.size();
+            index++) {
+                if (!indices.contains(index)) throw new IllegalArgumentException("Order must be contiguous within each day");
+            }
+        }
+    }
+    public record Stop(@NotNull Long localId, @NotNull Integer day, @NotNull Integer orderIndex, @Size(max = 4000) String note,
+    @Pattern(regexp = "(?:[01][0-9]|2[0-3]):[0-5][0-9]") String scheduledTime, @NotNull Boolean completed) {
+        static Stop from(TripLocal stop) {
+            return new Stop(stop.getLocalId(), stop.getDay(), stop.getOrderIndex(), stop.getNote(),
+            stop.getScheduledTime() == null ? null : stop.getScheduledTime().format(java.time.format.DateTimeFormatter.ofPattern("HH:mm")), stop.isCompleted());
+        }
+    }
+    public record ItineraryRequest(@NotNull @Size(max = 1000) List<@NotNull @Valid Stop> expected,
+    @NotNull @Size(max = 1000) List<@NotNull @Valid Stop> stops) {
+    }
+}
