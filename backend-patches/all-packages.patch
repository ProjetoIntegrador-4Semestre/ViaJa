+package com.senac.viajaapi;
+import static org.junit.jupiter.api.Assertions.*;
+import org.junit.jupiter.api.Test;
+import tools.jackson.databind.json.JsonMapper;
+class WeatherParsingTest{
+    @Test void doesNotInventZeroForMissingTemperature(){
+        var data=new JsonMapper().readTree("{\"timezone\":\"America/Sao_Paulo\",\"daily\":{\"time\":[\"2026-11-18\"],\"temperature_2m_min\":[null],\"temperature_2m_max\":[29.5],\"weather_code\":[1]}}");
+        var view=OpenMeteoWeatherGateway.parse(data);
+        assertNull(view.days().get(0).minimum());
+        assertEquals(29.5,view.days().get(0).maximum());
+        assertEquals("Open-Meteo",view.source());
+    }
+    @Test void refusesIncompleteProviderResponse(){
+        assertThrows(IllegalArgumentException.class,()->OpenMeteoWeatherGateway.parse(new JsonMapper().readTree("{\"daily\":{\"time\":[\"2026-11-18\"]}}")));
+    }
+}
