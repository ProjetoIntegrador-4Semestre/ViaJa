new file mode 100644
--- /dev/null
+++ b/src/main/java/com/senac/viajaapi/AccountController.java
@@ -0,0 +1,65 @@
+package com.senac.viajaapi;
+import java.time.LocalDateTime;
+import java.util.*;
+import org.springframework.web.bind.annotation.*;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.server.ResponseStatusException;
+import org.springframework.security.crypto.password.PasswordEncoder;
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.*;
+@RestController
+@RequestMapping("/account/profile")
+public class AccountController {
+    private final UserRepository users;
+    private final UserInterestRepository links;
+    private final InterestRepository interests;
+    private final TripAccess access;
+    private final JwtService jwt;
+    private final PasswordEncoder passwords;
+    public AccountController(UserRepository users, UserInterestRepository links, InterestRepository interests, TripAccess access, JwtService jwt, PasswordEncoder passwords) {
+        this.users=users;
+        this.links=links;
+        this.interests=interests;
+        this.access=access;
+        this.jwt=jwt;
+        this.passwords=passwords;
+    }
+    @GetMapping public ProfileView get() {
+        return view(users.findById(access.currentUserId()).orElseThrow());
+    }
+    @PutMapping @Transactional public ProfileSession save(@Valid @RequestBody ProfileWrite request) {
+        Long id=access.currentUserId();
+        User user=users.lockById(id).orElseThrow();
+        String email=request.email().trim().toLowerCase(Locale.ROOT);
+        if (!Set.of("work","tourism").contains(request.defaultMode()) || request.interestIds()==null || request.interestIds().size()>50) throw new IllegalArgumentException("Invalid preferences");
+        if (!user.getEmail().equals(email)) {
+            if (request.currentPassword()==null || user.getPasswordHash()==null || !passwords.matches(request.currentPassword(),user.getPasswordHash())) throw new ResponseStatusException(HttpStatus.FORBIDDEN,"Current password required to change email");
+            if(users.findByEmail(email).filter(other->!other.getId().equals(id)).isPresent()) throw new ResponseStatusException(HttpStatus.CONFLICT,"Email already registered");
+        }
+        for(Long interest:request.interestIds()) if(interest==null || !interests.existsById(interest)) throw new IllegalArgumentException("Invalid interest");
+        user.setName(request.name().trim());
+        user.setEmail(email);
+        user.setDefaultMode(request.defaultMode());
+        user.setUpdatedAt(LocalDateTime.now());
+        users.saveAndFlush(user);
+        var previous=links.findById_UserId(id,org.springframework.data.domain.Pageable.unpaged()).getContent();
+        links.deleteAll(previous);
+        links.flush();
+        for(Long interest:request.interestIds()) links.save(new UserInterest(id,interest,LocalDateTime.now()));
+        String token=jwt.generateToken(org.springframework.security.core.userdetails.User.withUsername(email).password("").authorities("ROLE_USER").build());
+        return new ProfileSession(token,view(user));
+    }
+    private ProfileView view(User user) {
+        var selected=links.findById_UserId(user.getId(),org.springframework.data.domain.Pageable.unpaged()).stream().map(UserInterest::getInterestId).toList();
+        return new ProfileView(user.getId(),user.getName(),user.getEmail(),user.getDefaultMode(),selected,interests.findAll().stream().map(i->new InterestOption(i.getId(),i.getName())).toList());
+    }
+    public record InterestOption(Long id,String name) {
+    }
+    public record ProfileView(Long id,String name,String email,String defaultMode,List<Long> interestIds,List<InterestOption> interests) {
+    }
+    public record ProfileSession(String token,ProfileView user) {
+    }
+    public record ProfileWrite(@NotBlank @Size(max=120) String name,@NotBlank @Email @Size(max=254) String email,@NotNull String defaultMode,@NotNull Set<Long> interestIds,String currentPassword) {
+    }
+}
diff --git a/src/main/java/com/senac/viajaapi/AiController.java b/src/main/java/com/senac/viajaapi/AiController.java
new file mode 100644
--- /dev/null
+++ b/src/main/java/com/senac/viajaapi/AiController.java
@@ -0,0 +1,176 @@
+package com.senac.viajaapi;
+import java.time.*;
+import java.time.temporal.ChronoUnit;
+import java.util.*;
+import org.springframework.web.bind.annotation.*;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.server.ResponseStatusException;
+import tools.jackson.databind.ObjectMapper;
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.*;
+@RestController
+@RequestMapping("/ai")
+public class AiController {
+    private final AiSessionRepository sessions;
+    private final AiTurnRepository turns;
+    private final TripAccess access;
+    private final UserRepository users;
+    private final LocalRepository places;
+    private final TripLocalRepository stops;
+    private final UserInterestRepository interests;
+    private final InterestRepository interestNames;
+    private final Entitlements rights;
+    private final AiGateway gateway;
+    private final ItineraryController itineraries;
+    private final ObjectMapper json;
+    public AiController(AiSessionRepository sessions,AiTurnRepository turns,TripAccess access,UserRepository users,LocalRepository places,TripLocalRepository stops,UserInterestRepository interests,InterestRepository interestNames,Entitlements rights,AiGateway gateway,ItineraryController itineraries,ObjectMapper json){
+        this.sessions=sessions;
+        this.turns=turns;
+        this.access=access;
+        this.users=users;
+        this.places=places;
+        this.stops=stops;
+        this.interests=interests;
+        this.interestNames=interestNames;
+        this.rights=rights;
+        this.gateway=gateway;
+        this.itineraries=itineraries;
+        this.json=json;
+    }
+    @GetMapping("/quota") public Quota quota(){
+        return quotaFor(access.currentUserId());
+    }
+    private Quota quotaFor(Long user){
+        boolean premium=rights.premium(user);
+        String period=rights.period(user);
+        return new Quota(gateway.configured(),Math.max(0,(premium?20:2)-(int)turns.countByOwnerIdAndKindAndQuotaPeriod(user,"plan",period)),Math.max(0,(premium?200:40)-(int)turns.countByOwnerIdAndCreatedAtAfter(user,LocalDate.now(ZoneId.of("America/Sao_Paulo")).atStartOfDay(ZoneId.of("America/Sao_Paulo")).toInstant())),period,premium?period.substring("premium:".length()):YearMonth.now(ZoneId.of("America/Sao_Paulo")).plusMonths(1).atDay(1).atStartOfDay(ZoneId.of("America/Sao_Paulo")).toInstant().toString());
+    }
+    @GetMapping("/sessions") public List<SessionView> list(){
+        return sessions.findByOwnerIdOrderByUpdatedAtDesc(access.currentUserId()).stream().map(s->new SessionView(s.id,s.tripId,s.title)).toList();
+    }
+    @PutMapping("/sessions/{id}") @Transactional public SessionView create(@PathVariable String id,@RequestBody SessionWrite request){
+        UUID.fromString(id);
+        Long owner=access.currentUserId();
+        if(request.tripId()!=null)access.requireOwner(request.tripId());
+        var s=sessions.findById(id).orElse(null);
+        if(s!=null&&!s.ownerId.equals(owner))throw new org.springframework.security.access.AccessDeniedException("Access denied");
+        if(s==null){
+            s=new AiSession();
+            s.id=id;
+            s.ownerId=owner;
+            s.tripId=request.tripId();
+            s.title="Nova conversa";
+            s.updatedAt=Instant.now();
+            sessions.save(s);
+        }else if(!Objects.equals(s.tripId,request.tripId()))throw new IllegalArgumentException("Session context is immutable");
+        return new SessionView(s.id,s.tripId,s.title);
+    }
+    private AiSession owned(String id){
+        var s=sessions.findById(id).orElseThrow(()->new ResponseStatusException(HttpStatus.NOT_FOUND,"Session not found"));
+        if(!s.ownerId.equals(access.currentUserId()))throw new org.springframework.security.access.AccessDeniedException("Access denied");
+        return s;
+    }
+    @GetMapping("/sessions/{id}") public List<TurnView> history(@PathVariable String id){
+        owned(id);
+        return turns.findBySessionIdOrderByCreatedAtAsc(id).stream().map(this::view).toList();
+    }
+    @DeleteMapping("/sessions/{id}") @Transactional public void delete(@PathVariable String id){
+        if(sessions.existsById(id)){
+            owned(id);
+            turns.deleteBySessionId(id);
+            sessions.deleteById(id);
+        }
+    }
+    @PostMapping("/sessions/{id}/messages") @Transactional public TurnView message(@PathVariable String id,@Valid @RequestBody Message request){
+        AiSession session=owned(id);
+        users.lockById(session.ownerId).orElseThrow();
+        UUID.fromString(request.requestId());
+        String key=id+":"+request.requestId();
+        var old=turns.findById(key).orElse(null);
+        if(old!=null){
+            if(!Objects.equals(old.requestJson,json.writeValueAsString(request)))throw new ResponseStatusException(HttpStatus.CONFLICT,"Request reused with another message");
+            return view(old);
+        }
+        if(request.mode()!=null&&!Set.of("work","tourism").contains(request.mode())||request.pace()!=null&&!Set.of("Tranquilo","Equilibrado","Intenso").contains(request.pace()))throw new IllegalArgumentException("Invalid conversation context");
+        if(!Set.of("chat","plan").contains(request.kind()))throw new IllegalArgumentException("Invalid message kind");
+        var quota=quotaFor(session.ownerId);
+        if(!quota.available())throw new ResponseStatusException(HttpStatus.SERVICE_UNAVAILABLE,"Assistant temporarily unavailable");
+        if(quota.dailyRemaining()<1||request.kind().equals("plan")&&quota.remaining()<1)throw new ResponseStatusException(HttpStatus.TOO_MANY_REQUESTS,"Assistant quota exhausted");
+        Trip trip=session.tripId==null?null:access.requireOwner(session.tripId);
+        int days=request.days()==null?0:request.days();
+        if(trip!=null&&trip.getStartDate()!=null&&trip.getEndDate()!=null)days=(int)ChronoUnit.DAYS.between(trip.getStartDate(),trip.getEndDate())+1;
+        if(request.kind().equals("plan")&&(trip==null||days<1||days>30))throw new IllegalArgumentException("Choose a trip and 1 to 30 days before generating a proposal");
+        var catalog=trip==null?List.<Local>of():places.findByCityIdOrderByNameAsc(trip.getCityId());
+        var selected=interests.findById_UserId(session.ownerId,org.springframework.data.domain.Pageable.unpaged()).stream().map(i->interestNames.findById(i.getInterestId()).map(Interest::getName).orElse("")).toList();
+        var context=new LinkedHashMap<String,Object>();
+        context.put("mode",request.kind());
+        context.put("days",days);
+        context.put("conversationMode",request.mode()==null?(trip==null?"tourism":trip.getMode()):request.mode());
+        context.put("pace",request.pace()==null?"Equilibrado":request.pace());
+        context.put("trip",trip==null?Map.of():Map.of("name",trip.getName(),"mode",trip.getMode(),"budgetCents",trip.getTotalBudgetCents()==null?"unknown":trip.getTotalBudgetCents()));
+        context.put("interests",selected);
+        context.put("places",catalog.stream().limit(100).map(p->Map.of("id",p.getId(),"name",p.getName(),"type",p.getType()==null?"unknown":p.getType(),"priceCents",p.getPrice()==null?"unknown":p.getPrice(),"source",p.getSource()==null?"unknown":p.getSource())).toList());
+        var expectedBefore=trip==null?List.<ItineraryController.Stop>of():stops.findById_TripIdOrderByDayAscOrderIndexAsc(trip.getId()).stream().map(ItineraryController.Stop::from).toList();
+        context.put("currentItinerary",expectedBefore);
+        var history=new ArrayList<>(turns.findBySessionIdOrderByCreatedAtDesc(id,org.springframework.data.domain.PageRequest.of(0,8)));
+        Collections.reverse(history);
+        var messages=new ArrayList<Map<String,String>>();
+        for(var turn:history){
+            messages.add(Map.of("role","user","content",turn.prompt));
+            messages.add(Map.of("role","assistant","content",turn.reply));
+        }
+        AiGateway.Result reply=gateway.respond(json.writeValueAsString(context),request.text(),messages);
+        if(reply==null||reply.reply()==null||reply.reply().isBlank()||reply.reply().length()>8000||reply.stops()==null||reply.stops().size()>150)throw new ResponseStatusException(HttpStatus.SERVICE_UNAVAILABLE,"Invalid provider response");
+        if(request.kind().equals("plan")&&reply.stops().isEmpty())throw new ResponseStatusException(HttpStatus.SERVICE_UNAVAILABLE,"Provider did not produce a valid proposal");
+        if(request.kind().equals("chat")&&!reply.stops().isEmpty())throw new ResponseStatusException(HttpStatus.SERVICE_UNAVAILABLE,"Unexpected proposal");
+        if(trip!=null){
+            Set<Long> allowed=new HashSet<>();
+            catalog.forEach(p->allowed.add(p.getId()));
+            Set<Long> seen=new HashSet<>();
+            for(var stop:reply.stops())if(stop==null||!allowed.contains(stop.localId())||!seen.add(stop.localId())||stop.day()==null||stop.day()<1||stop.day()>days||stop.note()!=null&&stop.note().length()>4000||Boolean.TRUE.equals(stop.completed())||stop.scheduledTime()!=null&&!stop.scheduledTime().matches("(?:[01][0-9]|2[0-3]):[0-5][0-9]"))throw new ResponseStatusException(HttpStatus.SERVICE_UNAVAILABLE,"Invalid proposal");
+            if(!reply.stops().isEmpty())ItineraryController.validate(trip,reply.stops());
+        }
+        var turn=new AiTurn();
+        turn.id=key;
+        turn.sessionId=id;
+        turn.ownerId=session.ownerId;
+        turn.kind=request.kind();
+        turn.quotaPeriod=rights.period(session.ownerId);
+        turn.createdAt=Instant.now();
+        turn.prompt=request.text();
+        turn.reply=reply.reply();
+        turn.requestJson=json.writeValueAsString(request);
+        turn.proposal=json.writeValueAsString(reply.stops());
+        turn.expected=json.writeValueAsString(expectedBefore);
+        turns.save(turn);
+        session.updatedAt=Instant.now();
+        if(session.title.equals("Nova conversa"))session.title=request.text().substring(0,Math.min(48,request.text().length()));
+        sessions.save(session);
+        return view(turn);
+    }
+    @PostMapping("/sessions/{id}/messages/{requestId}/apply") @Transactional public TurnView apply(@PathVariable String id,@PathVariable String requestId){
+        var session=owned(id);
+        if(session.tripId==null)throw new IllegalArgumentException("No trip");
+        access.requireOwnerForUpdate(session.tripId);
+        var turn=turns.findById(id+":"+requestId).orElseThrow();
+        if(turn.applied)return view(turn);
+        var desired=Arrays.asList(json.readValue(turn.proposal,ItineraryController.Stop[].class));
+        if(desired.isEmpty())throw new IllegalArgumentException("No proposal");
+        var expected=Arrays.asList(json.readValue(turn.expected,ItineraryController.Stop[].class));
+        itineraries.save(session.tripId,new ItineraryController.ItineraryRequest(expected,desired));
+        turn.applied=true;
+        turns.save(turn);
+        return view(turn);
+    }
+    private TurnView view(AiTurn t){
+        return new TurnView(t.id.substring(t.sessionId.length()+1),t.prompt,t.reply,Arrays.asList(json.readValue(t.proposal,ItineraryController.Stop[].class)),t.applied);
+    }
+    public record SessionWrite(Long tripId){
+    } public record SessionView(String id,Long tripId,String title){
+    } public record Quota(boolean available,int remaining,int dailyRemaining,String period,String renewsAt){
+    }
+    public record Message(@NotBlank String requestId,@NotBlank @Size(max=2000)String text,@NotNull String kind,Integer days,String mode,String pace){
+    } public record TurnView(String requestId,String prompt,String reply,List<ItineraryController.Stop> stops,boolean applied){
+    }
+}
