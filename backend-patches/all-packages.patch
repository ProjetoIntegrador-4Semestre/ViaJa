@@ -0,0 +1,175 @@
+package com.senac.viajaapi;
+import java.time.LocalDate;
+import java.util.*;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.*;
+import org.springframework.web.server.ResponseStatusException;
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.*;
+import io.swagger.v3.oas.annotations.Operation;
+@RestController
+@RequestMapping("/trips/{tripId}/expenses")
+public class TripExpenseController {
+    static final Set<String> CATEGORIES = Set.of("transport", "lodging", "food", "activities", "shopping", "other");
+    static final Set<String> REIMBURSEMENTS = Set.of("none", "pending", "requested", "received");
+    private final TripAccess access;
+    private final TripExpenseRepository expenses;
+    public TripExpenseController(TripAccess access, TripExpenseRepository expenses) {
+        this.access = access;
+        this.expenses = expenses;
+    }
+    @GetMapping
+    @Transactional(readOnly = true)
+    @Operation(summary = "Consultar despesas e resumo do orçamento")
+    public ExpenseReport report(@PathVariable Long tripId) {
+        Trip trip = access.requireOwner(tripId);
+        var items = expenses.findByTripIdOrderByExpenseDateDescCreatedAtDescIdAsc(tripId).stream().map(ExpenseView::from).toList();
+        long total = 0;
+        long refundable = 0;
+        long refunded = 0;
+        Map<String, Long> categories = new TreeMap<>();
+        for (ExpenseView item : items) {
+            total = Math.addExact(total, item.amountCents());
+            categories.merge(item.category(), item.amountCents(), Math::addExact);
+            if (!"none".equals(item.reimbursement())) refundable = Math.addExact(refundable, item.amountCents());
+            if ("received".equals(item.reimbursement())) refunded = Math.addExact(refunded, item.amountCents());
+        }
+        Long budget = trip.getTotalBudgetCents() == null ? null : trip.getTotalBudgetCents().longValue();
+        return new ExpenseReport(items, total, budget, budget == null ? null : budget - total, categories, refundable, refunded);
+    }
+    @PutMapping("/{id}")
+    @Transactional
+    @Operation(summary = "Criar ou editar despesa", description = "UUID do cliente evita duplicação; version previne sobrescrever edição concorrente. Não altera o orçamento da viagem nem confirma pagamentos externos.")
+    public ExpenseView save(@PathVariable Long tripId, @PathVariable String id, @Valid @RequestBody ExpenseRequest request) {
+        validate(id, request);
+        Trip trip = access.requireOwnerForUpdate(tripId);
+        LocalDate date;
+        try {
+            date = LocalDate.parse(request.expenseDate());
+        }
+        catch (RuntimeException error) {
+            throw new IllegalArgumentException("Invalid expense date; use yyyy-MM-dd");
+        }
+        if (date.getYear() < 1) throw new IllegalArgumentException("Invalid expense year");
+        var expense = expenses.findById(id).orElse(null);
+        if (expense != null && !expense.getTripId().equals(tripId)) throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Expense does not exist");
+        String description = request.description().trim();
+        if (expense != null && expense.getDescription().equals(description) && expense.getAmountCents() == request.amountCents()
+        && expense.getExpenseDate().equals(date) && expense.getCategory().equals(request.category())
+        && expense.getReimbursement().equals(request.reimbursement())) return ExpenseView.from(expense);
+        if (expense == null) {
+            if (request.version() != null) throw new ResponseStatusException(HttpStatus.CONFLICT, "Expense was removed; reload");
+            expense = new TripExpense(id, trip);
+        } else if (request.version() == null || expense.getVersion() != request.version()) {
+            throw new ResponseStatusException(HttpStatus.CONFLICT, "Expense changed; reload before editing");
+        }
+        expense.setDescription(description);
+        expense.setAmountCents(request.amountCents());
+        expense.setExpenseDate(date);
+        expense.setCategory(request.category());
+        expense.setReimbursement(request.reimbursement());
+        return ExpenseView.from(expenses.saveAndFlush(expense));
+    }
+    @DeleteMapping("/{id}")
+    @Transactional
+    @Operation(summary = "Excluir despesa", description = "Requer a version observada. Uma despesa já ausente retorna 204.")
+    public ResponseEntity<Void> delete(@PathVariable Long tripId, @PathVariable String id, @RequestParam long version) {
+        access.requireOwnerForUpdate(tripId);
+        var expense = expenses.findById(id).orElse(null);
+        if (expense != null && !expense.getTripId().equals(tripId)) throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Expense does not exist");
+        if (expense != null) {
+            if (expense.getVersion() != version) throw new ResponseStatusException(HttpStatus.CONFLICT, "Expense changed; reload before deleting");
+            expenses.delete(expense);
+        }
+        return ResponseEntity.noContent().build();
+    }
+    @GetMapping("/{id}/receipt")
+    @Transactional(readOnly = true)
+    @Operation(summary = "Baixar comprovante privado da despesa")
+    public ResponseEntity<byte[]> receipt(@PathVariable Long tripId, @PathVariable String id) {
+        access.requireOwner(tripId);
+        TripExpense expense = requireExpense(tripId, id);
+        if (!expense.hasReceipt()) throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Receipt does not exist");
+        return ResponseEntity.ok()
+        .contentType(org.springframework.http.MediaType.parseMediaType(expense.getReceiptType()))
+        .header("Content-Disposition", org.springframework.http.ContentDisposition.attachment()
+        .filename("comprovante." + extension(expense.getReceiptType())).build().toString())
+        .header("X-Content-Type-Options", "nosniff")
+        .cacheControl(org.springframework.http.CacheControl.noStore())
+        .body(expense.getReceipt());
+    }
+    @PutMapping(value = "/{id}/receipt", consumes = org.springframework.http.MediaType.MULTIPART_FORM_DATA_VALUE)
+    @Transactional
+    @Operation(summary = "Anexar ou substituir comprovante privado", description = "PDF, PNG ou JPEG de até 5 MiB. Requer a version da despesa; o arquivo não recebe URL pública.")
+    public ExpenseView uploadReceipt(@PathVariable Long tripId, @PathVariable String id, @RequestParam long version,
+    @RequestPart("file") org.springframework.web.multipart.MultipartFile file) throws java.io.IOException {
+        access.requireOwnerForUpdate(tripId);
+        TripExpense expense = requireExpense(tripId, id);
+        if (file.isEmpty() || file.getSize() > 5L * 1024 * 1024) throw new ResponseStatusException(HttpStatus.PAYLOAD_TOO_LARGE, "Receipt must contain up to 5 MiB");
+        byte[] bytes = file.getBytes();
+        String type = receiptType(bytes);
+        if (java.util.Arrays.equals(bytes, expense.getReceipt()) && type.equals(expense.getReceiptType())) return ExpenseView.from(expense);
+        if (expense.getVersion() != version) throw new ResponseStatusException(HttpStatus.CONFLICT, "Expense changed; reload before replacing receipt");
+        expense.setReceipt(bytes);
+        expense.setReceiptType(type);
+        return ExpenseView.from(expenses.saveAndFlush(expense));
+    }
+    @DeleteMapping("/{id}/receipt")
+    @Transactional
+    @Operation(summary = "Remover comprovante privado")
+    public ExpenseView deleteReceipt(@PathVariable Long tripId, @PathVariable String id, @RequestParam long version) {
+        access.requireOwnerForUpdate(tripId);
+        TripExpense expense = requireExpense(tripId, id);
+        if (!expense.hasReceipt()) return ExpenseView.from(expense);
+        if (expense.getVersion() != version) throw new ResponseStatusException(HttpStatus.CONFLICT, "Expense changed; reload before removing receipt");
+        expense.setReceipt(null);
+        expense.setReceiptType(null);
+        return ExpenseView.from(expenses.saveAndFlush(expense));
+    }
+    private TripExpense requireExpense(Long tripId, String id) {
+        var expense = expenses.findById(id).orElseThrow(() -> new ResponseStatusException(HttpStatus.NOT_FOUND, "Expense does not exist"));
+        if (!expense.getTripId().equals(tripId)) throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Expense does not exist");
+        return expense;
+    }
+    static String receiptType(byte[] bytes) {
+        if (bytes.length >= 5 && bytes[0] == '%' && bytes[1] == 'P' && bytes[2] == 'D' && bytes[3] == 'F' && bytes[4] == '-') return "application/pdf";
+        byte[] png = {
+            (byte) 137, 80, 78, 71, 13, 10, 26, 10
+        };
+        if (bytes.length >= png.length && java.util.Arrays.equals(java.util.Arrays.copyOf(bytes, png.length), png)) return "image/png";
+        if (bytes.length >= 3 && (bytes[0] & 255) == 255 && (bytes[1] & 255) == 216 && (bytes[2] & 255) == 255) return "image/jpeg";
+        throw new IllegalArgumentException("Receipt must be PDF, PNG or JPEG");
+    }
+    private static String extension(String type) {
+        return "application/pdf".equals(type) ? "pdf" : "image/png".equals(type) ? "png" : "jpg";
+    }
+    static void validate(String id, ExpenseRequest request) {
+        try {
+            if (!UUID.fromString(id).toString().equals(id)) throw new IllegalArgumentException("Invalid UUID");
+        }
+        catch (RuntimeException error) {
+            throw new IllegalArgumentException("Use a canonical expense UUID");
+        }
+        if (request.description() == null || request.description().isBlank() || request.description().length() > 160) throw new IllegalArgumentException("Invalid description");
+        if (request.amountCents() == null || request.amountCents() < 1 || request.amountCents() > Integer.MAX_VALUE) throw new IllegalArgumentException("Invalid amount");
+        if (request.expenseDate() == null || !request.expenseDate().matches("[0-9]{4}-[0-9]{2}-[0-9]{2}")) throw new IllegalArgumentException("Invalid date");
+        if (!CATEGORIES.contains(request.category() == null ? "" : request.category())) throw new IllegalArgumentException("Invalid category");
+        if (!REIMBURSEMENTS.contains(request.reimbursement() == null ? "" : request.reimbursement())) throw new IllegalArgumentException("Invalid reimbursement state");
