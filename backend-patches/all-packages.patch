@@ -0,0 +1,37 @@
+package com.senac.viajaapi;
+import java.time.*;
+import java.util.*;
+import org.springframework.stereotype.Component;
+import org.springframework.web.client.RestClient;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.server.ResponseStatusException;
+import tools.jackson.databind.JsonNode;
+@Component public class OpenMeteoWeatherGateway implements WeatherGateway{
+    public TripResourcesController.WeatherView forecast(double latitude,double longitude){
+        try{
+            var factory=new org.springframework.http.client.JdkClientHttpRequestFactory(java.net.http.HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(5)).build());
+            factory.setReadTimeout(Duration.ofSeconds(8));
+            JsonNode data=RestClient.builder().requestFactory(factory).baseUrl("https://api.open-meteo.com").build().get().uri(u->u.path("/v1/forecast").queryParam("latitude",latitude).queryParam("longitude",longitude).queryParam("daily","temperature_2m_min,temperature_2m_max,weather_code").queryParam("timezone","auto").queryParam("forecast_days",7).build()).retrieve().body(JsonNode.class);
+            return parse(data);
+        }catch(Exception failure){
+            throw new ResponseStatusException(HttpStatus.SERVICE_UNAVAILABLE,"Weather provider unavailable");
+        }
+    }
+    static TripResourcesController.WeatherView parse(JsonNode data){
+        if(data==null||!data.path("daily").path("time").isArray()||data.path("daily").path("time").isEmpty())throw new IllegalArgumentException("Missing forecast");
+        var daily=data.path("daily");
+        int length=daily.path("time").size();
+        if(length>16||daily.path("temperature_2m_min").size()!=length||daily.path("temperature_2m_max").size()!=length||daily.path("weather_code").size()!=length)throw new IllegalArgumentException("Inconsistent forecast");
+        var days=new ArrayList<TripResourcesController.WeatherDay>();
+        for(int i=0;
+        i<length;
+        i++){
+            String date=daily.path("time").get(i).asText();
+            LocalDate.parse(date);
+            var min=daily.path("temperature_2m_min").get(i);
+            var max=daily.path("temperature_2m_max").get(i);
+            var code=daily.path("weather_code").get(i);
+            days.add(new TripResourcesController.WeatherDay(date,min.isNumber()?min.asDouble():null,max.isNumber()?max.asDouble():null,code.isNumber()?code.asInt():null));
+        }return new TripResourcesController.WeatherView("Open-Meteo",Instant.now().toString(),data.path("timezone").asText(),days);
+    }
+}
