+            assertEquals(401,assertThrows(ResponseStatusException.class,()->in(tx,()->google.result(new GoogleLoginController.Poll(start.pollToken())))).getStatusCode().value());
+            auth("nobody@example.invalid");
+            assertThrows(org.springframework.security.access.AccessDeniedException.class,()->ai.history(session));
+            assertThrows(org.springframework.security.access.AccessDeniedException.class,()->resources.export(trip.getId(),false));
