new file mode 100644
--- /dev/null
+++ b/src/test/java/com/senac/viajaapi/GoogleVerificationTest.java
@@ -0,0 +1,52 @@
+package com.senac.viajaapi;
+import static org.junit.jupiter.api.Assertions.*;
+import java.time.Instant;
+import java.util.*;
+import java.security.*;
+import org.junit.jupiter.api.Test;
+import tools.jackson.databind.json.JsonMapper;
+class GoogleVerificationTest {
+    @Test void validatesSignatureAudienceIssuerNonceAndExpiry()throws Exception{
+        var json=new JsonMapper();
+        var gateway=new GoogleOAuthGateway("test-client","test-secret","https://example.invalid/callback",json);
+        var generator=KeyPairGenerator.getInstance("RSA");
+        generator.initialize(2048);
+        var pair=generator.generateKeyPair();
+        var field=GoogleOAuthGateway.class.getDeclaredField("keys");
+        field.setAccessible(true);
+        field.set(gateway,Map.of("test-key",pair.getPublic()));
+        var expiry=GoogleOAuthGateway.class.getDeclaredField("keyExpires");
+        expiry.setAccessible(true);
+        expiry.set(gateway,Instant.now().plusSeconds(1000));
+        var claims=new HashMap<String,Object>();
+        claims.put("aud","test-client");
+        claims.put("iss","https://accounts.google.com");
+        claims.put("exp",Instant.now().plusSeconds(120).getEpochSecond());
+        claims.put("iat",Instant.now().getEpochSecond());
+        claims.put("nonce","expected-nonce");
+        claims.put("email_verified",true);
+        claims.put("sub","google-test-id");
+        claims.put("email","verified@example.invalid");
+        claims.put("name","Verified");
+        String token=sign(json,claims,pair.getPrivate());
+        assertEquals("google-test-id",gateway.verify(token,"expected-nonce").id());
+        assertThrows(IllegalArgumentException.class,()->gateway.verify(token,"wrong-nonce"));
+        claims.put("aud","other-client");
+        String wrongAudience=sign(json,claims,pair.getPrivate());
+        assertThrows(IllegalArgumentException.class,()->gateway.verify(wrongAudience,"expected-nonce"));
+        claims.put("aud","test-client");
+        claims.put("exp",1);
+        String expired=sign(json,claims,pair.getPrivate());
+        assertThrows(IllegalArgumentException.class,()->gateway.verify(expired,"expected-nonce"));
+        assertThrows(IllegalArgumentException.class,()->gateway.verify("eyJhbGciOiJub25lIn0.e30.","expected-nonce"));
+        assertTrue(gateway.authorization("state","nonce","verifier").contains("code_challenge_method=S256"));
+    }
+    private String sign(JsonMapper json,Map<String,Object> claims,PrivateKey key)throws Exception{
+        var base=Base64.getUrlEncoder().withoutPadding();
+        String input=base.encodeToString(json.writeValueAsBytes(Map.of("alg","RS256","kid","test-key")))+"."+base.encodeToString(json.writeValueAsBytes(claims));
+        var signature=Signature.getInstance("SHA256withRSA");
+        signature.initSign(key);
+        signature.update(input.getBytes(java.nio.charset.StandardCharsets.US_ASCII));
+        return input+"."+base.encodeToString(signature.sign());
+    }
+}
