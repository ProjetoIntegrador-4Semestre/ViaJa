+package com.senac.viajaapi;
+import java.util.List;
+import java.util.UUID;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.*;
+import org.springframework.web.server.ResponseStatusException;
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.NotBlank;
+import jakarta.validation.constraints.NotNull;
+import jakarta.validation.constraints.Size;
+import io.swagger.v3.oas.annotations.Operation;
+@RestController
+@RequestMapping("/trips/{tripId}/checklist")
+public class TripChecklistController {
+    private final TripAccess access;
+    private final TripChecklistRepository items;
+    public TripChecklistController(TripAccess access, TripChecklistRepository items) {
+        this.access = access;
+        this.items = items;
+    }
+    @GetMapping
+    @Operation(summary = "Consultar checklist da viagem")
+    public List<TripChecklistItem> list(@PathVariable Long tripId) {
+        access.requireOwner(tripId);
+        return items.findByTripIdOrderByCreatedAtAscIdAsc(tripId);
+    }
+    @PutMapping("/{id}")
+    @Transactional
+    @Operation(summary = "Criar ou atualizar item de checklist", description = "UUID gerado pelo cliente permite repetir a mesma gravação sem duplicar o item.")
+    public TripChecklistItem save(@PathVariable Long tripId, @PathVariable String id, @Valid @RequestBody ItemRequest request) {
+        UUID uuid;
+        try {
+            uuid = UUID.fromString(id);
+        }
+        catch (IllegalArgumentException error) {
+            throw new IllegalArgumentException("Invalid item UUID");
+        }
+        if (!uuid.toString().equals(id)) throw new IllegalArgumentException("Use a canonical lowercase UUID");
+        if (request.label() == null || request.label().isBlank() || request.label().length() > 240 || request.completed() == null) {
+            throw new IllegalArgumentException("Invalid checklist item");
+        }
+        Trip trip = access.requireOwnerForUpdate(tripId);
+        var item = items.findById(id).orElse(null);
+        if (item != null && !item.getTripId().equals(tripId)) throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Item does not exist");
+        if (item == null) item = new TripChecklistItem(id, trip, request.label().trim(), request.completed());
+        else {
+            item.setLabel(request.label().trim());
+            item.setCompleted(request.completed());
+        }
+        return items.save(item);
+    }
+    @DeleteMapping("/{id}")
+    @Transactional
+    @Operation(summary = "Excluir item do checklist")
+    public ResponseEntity<Void> delete(@PathVariable Long tripId, @PathVariable String id) {
+        access.requireOwnerForUpdate(tripId);
+        var item = items.findById(id).orElse(null);
+        if (item != null && !item.getTripId().equals(tripId)) throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Item does not exist");
+        if (item != null) items.delete(item);
+        return ResponseEntity.noContent().build();
+    }
+    public record ItemRequest(@NotBlank @Size(max = 240) String label, @NotNull Boolean completed) {
+    }
+}
