@@ -0,0 +1,100 @@
+package com.senac.viajaapi;
+import java.time.*;
+import java.util.*;
+import java.util.concurrent.*;
+import java.nio.charset.StandardCharsets;
+import java.security.*;
+import org.springframework.web.bind.annotation.*;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.server.ResponseStatusException;
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.*;
+@RestController @RequestMapping("/auth")
+public class RecoveryController {
+    private final UserRepository users;
+    private final RecoveryTokenRepository tokens;
+    private final MailGateway mail;
+    private final org.springframework.security.crypto.password.PasswordEncoder passwords;
+    private final Map<String,List<Instant>> attempts=new HashMap<>();
+    private static final ExecutorService DELIVERY=new ThreadPoolExecutor(1,2,30,TimeUnit.SECONDS,new ArrayBlockingQueue<>(64),r->{
+        Thread t=new Thread(r,"viaja-recovery");
+        t.setDaemon(true);
+        return t;
+    },new ThreadPoolExecutor.AbortPolicy());
+    public RecoveryController(UserRepository users,RecoveryTokenRepository tokens,MailGateway mail,org.springframework.security.crypto.password.PasswordEncoder passwords){
+        this.users=users;
+        this.tokens=tokens;
+        this.mail=mail;
+        this.passwords=passwords;
+    }
+    public static String hash(String raw){
+        try{
+            return HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(raw.getBytes(StandardCharsets.UTF_8)));
+        }catch(Exception e){
+            throw new IllegalStateException(e);
+        }
+    }
+    static String random(){
+        byte[] bytes=new byte[32];
+        new SecureRandom().nextBytes(bytes);
+        return Base64.getUrlEncoder().withoutPadding().encodeToString(bytes);
+    }
+    @PostMapping("/recovery") @Transactional public ApiResponse request(@Valid @RequestBody Recovery request){
+        if(!mail.configured())throw new ResponseStatusException(HttpStatus.SERVICE_UNAVAILABLE,"Recovery service unavailable");
+        String email=request.email().trim().toLowerCase(Locale.ROOT);
+        synchronized(attempts){
+            if(attempts.size()>10000)attempts.clear();
+            var list=attempts.computeIfAbsent(hash(email),k->new ArrayList<>());
+            list.removeIf(t->t.plusSeconds(3600).isBefore(Instant.now()));
+            if(list.size()>=3)throw new ResponseStatusException(HttpStatus.TOO_MANY_REQUESTS,"Try later");
+            list.add(Instant.now());
+        }
+        var user=users.findByEmail(email).orElse(null);
+        String raw=random();
+        if(user!=null){
+            users.lockById(user.getId()).orElseThrow();
+            var token=new RecoveryToken();
+            token.hash=hash(raw);
+            token.ownerId=user.getId();
+            token.expiresAt=Instant.now().plusSeconds(1200);
+            tokens.save(token);
+        }
+        Runnable task=()->{
+            if(user!=null)try{
+                mail.recovery(email,raw);
+            }catch(Exception failure){
+                System.getLogger("viaja.recovery").log(System.Logger.Level.WARNING,"Recovery delivery failed");
+            }
+        };
+        if(org.springframework.transaction.support.TransactionSynchronizationManager.isSynchronizationActive())org.springframework.transaction.support.TransactionSynchronizationManager.registerSynchronization(new org.springframework.transaction.support.TransactionSynchronization(){
+            public void afterCommit(){
+                try{
+                    DELIVERY.execute(task);
+                }catch(RejectedExecutionException ignored){
+                    System.getLogger("viaja.recovery").log(System.Logger.Level.WARNING,"Recovery delivery queue full");
+                }
+            }
+        });
+        else DELIVERY.execute(task);
+        return new ApiResponse("ok","Se o endereço estiver cadastrado, você receberá instruções para recuperar o acesso.");
+    }
+    @PostMapping("/reset") @Transactional public ApiResponse reset(@Valid @RequestBody Reset request){
+        if(request.password().getBytes(StandardCharsets.UTF_8).length>72)throw new IllegalArgumentException("Password exceeds 72 UTF-8 bytes");
+        var token=tokens.lock(hash(request.token())).orElseThrow(()->new IllegalArgumentException("Invalid or expired code"));
+        if(!token.expiresAt.isAfter(Instant.now()))throw new IllegalArgumentException("Invalid or expired code");
+        var user=users.lockById(token.ownerId).orElseThrow();
+        user.setPasswordHash(passwords.encode(request.password()));
+        user.setSessionVersion(user.getSessionVersion()+1);
+        if("google-external-email".equals(user.getAuthProvider())){
+            user.setGoogleId(null);
+            user.setAuthProvider("password");
+        }
+        users.save(user);
+        tokens.deleteByOwnerId(user.getId());
+        return new ApiResponse("ok","Senha alterada. Entre novamente.");
+    }
+    public record Recovery(@NotBlank @Email @Size(max=254)String email){
+    }public record Reset(@NotBlank @Size(max=200)String token,@NotBlank @Size(min=8,max=72)String password){
+    }
+}
