+package com.senac.viajaapi;
+import java.time.LocalDate;
+import java.time.LocalDateTime;
+import jakarta.persistence.*;
+import com.fasterxml.jackson.annotation.JsonIgnore;
+@Entity
+@Table(name = "trip_expenses")
+public class TripExpense {
+    @Id @Column(length = 36)
+    private String id;
+    @Column(name = "trip_id", nullable = false)
+    private Long tripId;
+    @ManyToOne(optional = false)
+    @JoinColumn(name = "trip_id", insertable = false, updatable = false)
+    private Trip trip;
+    @Column(nullable = false, length = 160)
+    private String description;
+    @Column(nullable = false)
+    private long amountCents;
+    @Column(nullable = false)
+    private LocalDate expenseDate;
+    @Column(nullable = false, length = 24)
+    private String category;
+    @Column(nullable = false, length = 24)
+    private String reimbursement;
+    @Lob
+    @Basic(fetch = FetchType.LAZY)
+    private byte[] receipt;
+    @Column(length = 32)
+    private String receiptType;
+    @Version
+    private long version;
+    private LocalDateTime createdAt;
+    public TripExpense() {
+    }
+    public TripExpense(String id, Trip trip) {
+        this.id = id;
+        this.tripId = trip.getId();
+        this.trip = trip;
+        this.createdAt = LocalDateTime.now();
+    }
+    public String getId() {
+        return id;
+    }
+    public Long getTripId() {
+        return tripId;
+    }
+    @JsonIgnore public Trip getTrip() {
+        return trip;
+    }
+    public String getDescription() {
+        return description;
+    }
+    public void setDescription(String value) {
+        description = value;
+    }
+    public long getAmountCents() {
+        return amountCents;
+    }
+    public void setAmountCents(long value) {
+        amountCents = value;
+    }
+    public LocalDate getExpenseDate() {
+        return expenseDate;
+    }
+    public void setExpenseDate(LocalDate value) {
+        expenseDate = value;
+    }
+    public String getCategory() {
+        return category;
+    }
+    public void setCategory(String value) {
+        category = value;
+    }
+    public String getReimbursement() {
+        return reimbursement;
+    }
+    public void setReimbursement(String value) {
+        reimbursement = value;
+    }
+    @JsonIgnore public byte[] getReceipt() {
+        return receipt;
+    }
+    public void setReceipt(byte[] value) {
+        receipt = value;
+    }
+    public String getReceiptType() {
+        return receiptType;
+    }
+    public void setReceiptType(String value) {
+        receiptType = value;
+    }
+    public boolean hasReceipt() {
+        return receipt != null && receipt.length > 0;
+    }
+    public long getVersion() {
+        return version;
+    }
+    public LocalDateTime getCreatedAt() {
+        return createdAt;
+    }
+}
