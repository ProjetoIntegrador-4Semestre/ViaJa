@@ -0,0 +1,45 @@
+package com.senac.viajaapi;
+
+import static org.junit.jupiter.api.Assertions.*;
+import java.nio.file.Path;
+import java.time.*;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.springframework.boot.WebApplicationType;
+import org.springframework.boot.builder.SpringApplicationBuilder;
+import org.springframework.context.ConfigurableApplicationContext;
+
+class PersistenceRestartTest {
+    @TempDir Path directory;
+
+    @Test void persistentProfileKeepsAccountTripAndEntitlementAcrossRestart() {
+        String database="jdbc:h2:file:"+directory.resolve("journey").toAbsolutePath();
+        Long owner,tripId;
+        try(var context=open(database)) {
+            var users=context.getBean(UserRepository.class);
+            assertEquals(0,users.count());
+            var user=users.saveAndFlush(new User("Persistent fixture","persist@example.invalid","test-hash","tourism",LocalDateTime.now(),LocalDateTime.now()));
+            owner=user.getId();
+            var city=context.getBean(CityRepository.class).saveAndFlush(new City("Fixture","SP","BR",null));
+            var trip=context.getBean(TripRepository.class).saveAndFlush(new Trip(owner,city.getId(),"Persistent trip","tourism",null,null,10000,"planned",LocalDateTime.now(),LocalDateTime.now()));
+            tripId=trip.getId();
+            var membership=new StripeMembership();
+            membership.userId=owner;
+            membership.status="active";
+            membership.paidUntil=Instant.now().plusSeconds(3600);
+            context.getBean(StripeMembershipRepository.class).saveAndFlush(membership);
+        }
+        try(var context=open(database)) {
+            assertEquals(1,context.getBean(UserRepository.class).count());
+            assertEquals("Persistent fixture",context.getBean(UserRepository.class).findById(owner).orElseThrow().getName());
+            assertEquals("Persistent trip",context.getBean(TripRepository.class).findById(tripId).orElseThrow().getName());
+            assertTrue(context.getBean(Entitlements.class).premium(owner));
+        }
+    }
+
+    private ConfigurableApplicationContext open(String database) {
+        return new SpringApplicationBuilder(ViajaApiApplication.class).web(WebApplicationType.NONE).run(
+            "--spring.profiles.active=persistent","--spring.datasource.url="+database,"--spring.datasource.password=test-only-db-password",
+            "--spring.main.lazy-initialization=true","--spring.main.banner-mode=off","--logging.level.root=ERROR");
+    }
+}
