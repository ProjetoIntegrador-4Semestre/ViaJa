+package com.senac.viajaapi;
+import java.time.Instant;
+import java.time.YearMonth;
+import java.util.Set;
+import org.springframework.stereotype.Component;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.server.ResponseStatusException;
+@Component
+public class Entitlements {
+    private final StripeMembershipRepository memberships;
+    public Entitlements(StripeMembershipRepository memberships){
+        this.memberships=memberships;
+    }
+    public boolean premium(Long user){
+        var m=memberships.findById(user).orElse(null);
+        return m!=null&&m.paidUntil!=null&&m.paidUntil.isAfter(Instant.now())&&Set.of("active","past_due").contains(m.status);
+    }
+    public void requirePremium(Long user){
+        if(!premium(user))throw new ResponseStatusException(HttpStatus.FORBIDDEN,"Premium required");
+    }
+    public String period(Long user){
+        return premium(user)?"premium:"+memberships.findById(user).orElseThrow().paidUntil:YearMonth.now(java.time.ZoneId.of("America/Sao_Paulo")).toString();
+    }
+}
