+                "--spring.jpa.show-sql=false", "--spring.main.banner-mode=off", "--logging.level.root=ERROR")) {
+            var users = context.getBean(UserRepository.class);
+            var trips = context.getBean(TripRepository.class);
+            var expenses = context.getBean(TripExpenseRepository.class);
+            var access = context.getBean(TripAccess.class);
+            var transaction = new TransactionTemplate(context.getBean(PlatformTransactionManager.class));
+            var owner = users.findAll().get(0);
+            SecurityContextHolder.getContext().setAuthentication(UsernamePasswordAuthenticationToken.authenticated(owner.getEmail(), "", List.of()));
+            var city = context.getBean(CityRepository.class).findAll().get(0);
+            var trip = trips.saveAndFlush(new Trip(owner.getId(), city.getId(), "Expense test", "tourism", null, null, null,
+                    "planned", LocalDateTime.now(), LocalDateTime.now()));
+            var other = trips.saveAndFlush(new Trip(owner.getId(), city.getId(), "Other trip", "work", null, null, 0,
+                    "planned", LocalDateTime.now(), LocalDateTime.now()));
+            var controller = new TripExpenseController(access, expenses);
+            assertNull(controller.report(trip.getId()).budgetCents());
+            assertNull(controller.report(trip.getId()).remainingCents());
+            assertEquals(0L, controller.report(other.getId()).remainingCents());
+            String first = UUID.randomUUID().toString();
+            var firstRequest = new TripExpenseController.ExpenseRequest("Hotel", (long) Integer.MAX_VALUE, "2026-11-18", "lodging", "pending", null);
+            var created = in(transaction, () -> controller.save(trip.getId(), first, firstRequest));
+            in(transaction, () -> controller.save(trip.getId(), first, firstRequest));
+            assertEquals(1, controller.report(trip.getId()).expenses().size());
+            String second = UUID.randomUUID().toString();
+            in(transaction, () -> controller.save(trip.getId(), second, new TripExpenseController.ExpenseRequest("Transporte", (long) Integer.MAX_VALUE,
+                    "2026-10-01", "transport", "none", null)));
+            var report = controller.report(trip.getId());
+            assertEquals(4294967294L, report.totalCents());
+            assertEquals((long) Integer.MAX_VALUE, report.categoryTotals().get("lodging"));
+            assertEquals((long) Integer.MAX_VALUE, report.reimbursableCents());
+            assertEquals(0L, report.reimbursedCents());
+            byte[] receiptBytes = "%PDF-1.7\nprivate receipt".getBytes(java.nio.charset.StandardCharsets.UTF_8);
+            var multipart = new org.springframework.mock.web.MockMultipartFile("file", "comprovante.pdf", "application/pdf", receiptBytes);
+            var attached = in(transaction, () -> {
+                try { return controller.uploadReceipt(trip.getId(), first, created.version(), multipart); }
+                catch (java.io.IOException failure) { throw new RuntimeException(failure); }
+            });
+            assertTrue(attached.hasReceipt());
+            var replayedReceipt = in(transaction, () -> {
+                try { return controller.uploadReceipt(trip.getId(), first, created.version(), multipart); }
+                catch (java.io.IOException failure) { throw new RuntimeException(failure); }
+            });
+            assertEquals(attached.version(), replayedReceipt.version());
+            var attachment = in(transaction, () -> controller.receipt(trip.getId(), first));
+            assertArrayEquals(receiptBytes, attachment.getBody());
+            assertEquals("no-store", attachment.getHeaders().getCacheControl());
+            assertTrue(attachment.getHeaders().getFirst("Content-Disposition").contains("comprovante.pdf"));
+            assertEquals("nosniff", attachment.getHeaders().getFirst("X-Content-Type-Options"));
+            assertThrows(ResponseStatusException.class, () -> in(transaction, () -> controller.receipt(other.getId(), first)));
+            assertThrows(IllegalArgumentException.class, () -> in(transaction, () -> {
+                try { return controller.uploadReceipt(trip.getId(), first, attached.version(),
+                        new org.springframework.mock.web.MockMultipartFile("file", "fake.pdf", "application/pdf", "<html>".getBytes())); }
+                catch (java.io.IOException failure) { throw new RuntimeException(failure); }
+            }));
+            assertThrows(ResponseStatusException.class, () -> in(transaction, () -> {
+                try { return controller.uploadReceipt(trip.getId(), first, attached.version(),
+                        new org.springframework.mock.web.MockMultipartFile("file", "big.pdf", "application/pdf", new byte[5 * 1024 * 1024 + 1])); }
+                catch (java.io.IOException failure) { throw new RuntimeException(failure); }
+            }));
+            var detached = in(transaction, () -> controller.deleteReceipt(trip.getId(), first, attached.version()));
+            assertFalse(detached.hasReceipt());
+            assertThrows(ResponseStatusException.class, () -> in(transaction, () -> controller.receipt(trip.getId(), first)));
+            var changed = in(transaction, () -> controller.save(trip.getId(), first, new TripExpenseController.ExpenseRequest("Hotel revisado", 12345L,
+                    "2026-11-18", "lodging", "received", detached.version())));
+            assertTrue(changed.version() > created.version());
+            assertEquals(12345L, controller.report(trip.getId()).reimbursedCents());
+            assertEquals(2147495992L, controller.report(trip.getId()).totalCents(), "Reimbursement does not reduce the expense total");
+            var stale = assertThrows(ResponseStatusException.class, () -> in(transaction, () -> controller.save(trip.getId(), first,
+                    new TripExpenseController.ExpenseRequest("Stale overwrite", 1L, "2026-11-18", "other", "none", created.version()))));
+            assertEquals(409, stale.getStatusCode().value());
+            assertEquals(409, assertThrows(ResponseStatusException.class,
+                    () -> in(transaction, () -> controller.delete(trip.getId(), first, created.version()))).getStatusCode().value());
+            assertEquals(404, assertThrows(ResponseStatusException.class,
+                    () -> in(transaction, () -> controller.save(other.getId(), first, firstRequest))).getStatusCode().value());
+            assertThrows(IllegalArgumentException.class, () -> in(transaction, () -> controller.save(trip.getId(), UUID.randomUUID().toString(),
+                    new TripExpenseController.ExpenseRequest("Invalid", 0L, "2026-11-18", "food", "none", null))));
+            assertThrows(IllegalArgumentException.class, () -> in(transaction, () -> controller.save(trip.getId(), UUID.randomUUID().toString(),
+                    new TripExpenseController.ExpenseRequest("Invalid date", 1L, "2026-02-31", "food", "none", null))));
+            SecurityContextHolder.getContext().setAuthentication(UsernamePasswordAuthenticationToken.authenticated("not-owner@example.invalid", "", List.of()));
+            assertThrows(org.springframework.security.access.AccessDeniedException.class, () -> controller.report(trip.getId()));
+            assertThrows(org.springframework.security.access.AccessDeniedException.class, () -> in(transaction, () -> controller.receipt(trip.getId(), second)));
+            assertThrows(org.springframework.security.access.AccessDeniedException.class, () -> in(transaction, () -> controller.delete(trip.getId(), first, changed.version())));
+            SecurityContextHolder.getContext().setAuthentication(UsernamePasswordAuthenticationToken.authenticated(owner.getEmail(), "", List.of()));
+            in(transaction, () -> controller.delete(trip.getId(), first, changed.version()));
+            in(transaction, () -> controller.delete(trip.getId(), first, changed.version()));
+            assertEquals((long) Integer.MAX_VALUE, controller.report(trip.getId()).totalCents());
+            var remainingExpense = controller.report(trip.getId()).expenses().get(0);
+            in(transaction, () -> {
+                try { return controller.uploadReceipt(trip.getId(), second, remainingExpense.version(), multipart); }
+                catch (java.io.IOException failure) { throw new RuntimeException(failure); }
+            });
+            var tripController = new TripController(trips, users, context.getBean(CityRepository.class), context.getBean(TripLocalRepository.class),
+                    context.getBean(TripNoteRepository.class), context.getBean(TripMemoRepository.class), context.getBean(MediaRepository.class),
+                    context.getBean(TripChecklistRepository.class), expenses, new TripModelAssembler(), null);
+            in(transaction, () -> tripController.deleteTrip(trip.getId()));
+            assertFalse(expenses.existsById(second));
+            assertThrows(ResponseStatusException.class, () -> controller.receipt(trip.getId(), second));
+            assertFalse(trips.existsById(trip.getId()));
+            assertTrue(trips.existsById(other.getId()));
+        } finally { SecurityContextHolder.clearContext(); }
+    }
+
+    private static <T> T in(TransactionTemplate transaction, Supplier<T> action) { return transaction.execute(status -> action.get()); }
+}
