diff --git a/src/test/java/com/senac/viajaapi/ItineraryIntegrationTest.java b/src/test/java/com/senac/viajaapi/ItineraryIntegrationTest.java
new file mode 100644
--- /dev/null
+++ b/src/test/java/com/senac/viajaapi/ItineraryIntegrationTest.java
@@ -0,0 +1,95 @@
+package com.senac.viajaapi;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import java.time.LocalDate;
+import java.time.LocalDateTime;
+import java.util.List;
+import java.util.function.Supplier;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.boot.WebApplicationType;
+import org.springframework.boot.builder.SpringApplicationBuilder;
+import org.springframework.security.authentication.UsernamePasswordAuthenticationToken;
+import org.springframework.security.core.context.SecurityContextHolder;
+import org.springframework.transaction.PlatformTransactionManager;
+import org.springframework.transaction.support.TransactionTemplate;
+import org.springframework.web.server.ResponseStatusException;
+
+class ItineraryIntegrationTest {
+    @Test
+    void savesAtomicallyAndProtectsExpectedStateOwnershipAndMemos() {
+        try (var context = new SpringApplicationBuilder(ViajaApiApplication.class).web(WebApplicationType.NONE).run(
+                "--spring.main.lazy-initialization=true", "--spring.h2.console.enabled=false",
+                "--spring.datasource.url=jdbc:h2:mem:itinerary-test;DB_CLOSE_DELAY=-1",
+                "--spring.jpa.hibernate.ddl-auto=create-drop", "--spring.jpa.show-sql=false",
+                "--spring.main.banner-mode=off", "--logging.level.root=ERROR")) {
+            var users = context.getBean(UserRepository.class);
+            var trips = context.getBean(TripRepository.class);
+            var stops = context.getBean(TripLocalRepository.class);
+            var memos = context.getBean(TripMemoRepository.class);
+            var places = context.getBean(LocalRepository.class);
+            var access = context.getBean(TripAccess.class);
+            var transaction = new TransactionTemplate(context.getBean(PlatformTransactionManager.class));
+            var controller = new ItineraryController(access, stops, memos, places);
+            User owner = users.findAll().get(0);
+            SecurityContextHolder.getContext().setAuthentication(
+                    UsernamePasswordAuthenticationToken.authenticated(owner.getEmail(), "", List.of()));
+            Local first = places.findAll().get(0);
+            var candidates = places.findByCityIdOrderByNameAsc(first.getCityId());
+            assertTrue(candidates.size() >= 2, "Fixture needs two places in the same city");
+            Long a = candidates.get(0).getId();
+            Long b = candidates.get(1).getId();
+            var trip = trips.saveAndFlush(new Trip(owner.getId(), first.getCityId(), "Itinerary test", "tourism",
+                    LocalDate.of(2026, 12, 1), LocalDate.of(2026, 12, 3), 10000, "planned", LocalDateTime.now(), LocalDateTime.now()));
+            var entryA = new ItineraryController.Stop(a, 1, 1, "Keep note", "09:00", false);
+            var entryB = new ItineraryController.Stop(b, 1, 2, "Keep completion", "12:00", true);
+            List<ItineraryController.Stop> initial = List.of(entryA, entryB);
+            in(transaction, () -> controller.save(trip.getId(), new ItineraryController.ItineraryRequest(List.of(), initial)));
+            var movedB = new ItineraryController.Stop(b, 2, 1, entryB.note(), entryB.scheduledTime(), true);
+            List<ItineraryController.Stop> desired = List.of(entryA, movedB);
+            in(transaction, () -> controller.save(trip.getId(), new ItineraryController.ItineraryRequest(initial, desired)));
+            assertEquals(desired, snapshot(controller.get(trip.getId())));
+            in(transaction, () -> controller.save(trip.getId(), new ItineraryController.ItineraryRequest(initial, desired)));
+            assertEquals(2, controller.get(trip.getId()).size(), "Retry must not duplicate stops");
+            var conflict = assertThrows(ResponseStatusException.class, () -> in(transaction,
+                    () -> controller.save(trip.getId(), new ItineraryController.ItineraryRequest(initial, List.of(entryA)))));
+            assertEquals(409, conflict.getStatusCode().value());
+            assertEquals(desired, snapshot(controller.get(trip.getId())));
+            assertThrows(IllegalArgumentException.class, () -> in(transaction, () -> controller.save(trip.getId(),
+                    new ItineraryController.ItineraryRequest(desired, List.of(entryA, entryA)))));
+            assertThrows(IllegalArgumentException.class, () -> in(transaction, () -> controller.save(trip.getId(),
+                    new ItineraryController.ItineraryRequest(desired, List.of(new ItineraryController.Stop(a, 4, 1, null, null, false))))));
+            Long memoId = in(transaction, () -> {
+                var stop = stops.findById(new TripLocalId(trip.getId(), a)).orElseThrow();
+                var memo = new TripMemo(trip.getId(), a, "Linked memo", LocalDateTime.now());
+                memo.setTripLocal(stop);
+                return memos.saveAndFlush(memo).getId();
+            });
+            var invalidTime = new ItineraryController.Stop(b, 2, 1, "bad time", "25:99", false);
+            assertThrows(RuntimeException.class, () -> in(transaction,
+                    () -> controller.save(trip.getId(), new ItineraryController.ItineraryRequest(desired, List.of(invalidTime)))));
+            assertTrue(memos.existsById(memoId), "Rollback must restore a memo deleted earlier in the transaction");
+            assertEquals(desired, snapshot(controller.get(trip.getId())));
+            in(transaction, () -> controller.save(trip.getId(), new ItineraryController.ItineraryRequest(desired, List.of(movedB))));
+            assertFalse(memos.existsById(memoId));
+            assertFalse(stops.existsById(new TripLocalId(trip.getId(), a)));
+            SecurityContextHolder.getContext().setAuthentication(
+                    UsernamePasswordAuthenticationToken.authenticated("not-an-owner@example.invalid", "", List.of()));
+            assertThrows(org.springframework.security.access.AccessDeniedException.class,
+                    () -> controller.get(trip.getId()));
+            assertThrows(org.springframework.security.access.AccessDeniedException.class, () -> in(transaction,
+                    () -> controller.save(trip.getId(), new ItineraryController.ItineraryRequest(List.of(movedB), List.of()))));
+        } finally {
+            SecurityContextHolder.clearContext();
+        }
+    }
+
+    private static <T> T in(TransactionTemplate transaction, Supplier<T> action) {
+        return transaction.execute(status -> action.get());
+    }
+
+    private static List<ItineraryController.Stop> snapshot(List<TripLocal> stops) {
+        return stops.stream().map(ItineraryController.Stop::from).toList();
+    }
+}
