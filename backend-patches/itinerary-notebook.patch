+package com.senac.viajaapi;
+
+import static org.junit.jupiter.api.Assertions.*;
+import java.time.LocalDateTime;
+import java.util.List;
+import java.util.UUID;
+import java.util.function.Supplier;
+import org.junit.jupiter.api.Test;
+import org.springframework.boot.WebApplicationType;
+import org.springframework.boot.builder.SpringApplicationBuilder;
+import org.springframework.hateoas.EntityModel;
+import org.springframework.hateoas.Link;
+import org.springframework.security.authentication.UsernamePasswordAuthenticationToken;
+import org.springframework.security.core.context.SecurityContextHolder;
+import org.springframework.transaction.PlatformTransactionManager;
+import org.springframework.transaction.support.TransactionTemplate;
+import org.springframework.web.server.ResponseStatusException;
+
+class NotebookIntegrationTest {
+    @Test
+    void persistsNotesMemosAndChecklistWithOwnershipRetriesAndCleanup() {
+        try (var context = new SpringApplicationBuilder(ViajaApiApplication.class).web(WebApplicationType.NONE).run(
+                "--spring.main.lazy-initialization=true", "--spring.h2.console.enabled=false",
+                "--spring.datasource.url=jdbc:h2:mem:notebook-test;DB_CLOSE_DELAY=-1", "--spring.jpa.hibernate.ddl-auto=create-drop",
+                "--spring.jpa.show-sql=false", "--spring.main.banner-mode=off", "--logging.level.root=ERROR")) {
+            var users = context.getBean(UserRepository.class);
+            var trips = context.getBean(TripRepository.class);
+            var places = context.getBean(LocalRepository.class);
+            var stops = context.getBean(TripLocalRepository.class);
+            var notes = context.getBean(TripNoteRepository.class);
+            var memos = context.getBean(TripMemoRepository.class);
+            var items = context.getBean(TripChecklistRepository.class);
+            var access = context.getBean(TripAccess.class);
+            var transaction = new TransactionTemplate(context.getBean(PlatformTransactionManager.class));
+            var owner = users.findAll().get(0);
+            SecurityContextHolder.getContext().setAuthentication(UsernamePasswordAuthenticationToken.authenticated(owner.getEmail(), "", List.of()));
+            var place = places.findAll().get(0);
+            var trip = trips.saveAndFlush(new Trip(owner.getId(), place.getCityId(), "Notebook test", "tourism", null, null, null,
+                    "planned", LocalDateTime.now(), LocalDateTime.now()));
+            var other = trips.saveAndFlush(new Trip(owner.getId(), place.getCityId(), "Other trip", "tourism", null, null, null,
+                    "planned", LocalDateTime.now(), LocalDateTime.now()));
+            var checklist = new TripChecklistController(access, items);
+            String itemId = UUID.randomUUID().toString();
+            var request = new TripChecklistController.ItemRequest("Documento", false);
+            in(transaction, () -> checklist.save(trip.getId(), itemId, request));
+            in(transaction, () -> checklist.save(trip.getId(), itemId, request));
+            assertEquals(1, checklist.list(trip.getId()).size());
+            in(transaction, () -> checklist.save(trip.getId(), itemId, new TripChecklistController.ItemRequest("Documento", true)));
+            assertTrue(checklist.list(trip.getId()).get(0).isCompleted());
+            assertThrows(ResponseStatusException.class, () -> in(transaction, () -> checklist.save(other.getId(), itemId, request)));
+            assertThrows(IllegalArgumentException.class, () -> in(transaction,
+                    () -> checklist.save(trip.getId(), UUID.randomUUID().toString(), new TripChecklistController.ItemRequest(" ", false))));
+            var noteAssembler = new TripNoteModelAssembler() {
+                @Override public EntityModel<TripNote> toModel(TripNote note) { return EntityModel.of(note, Link.of("/notes/" + note.getId()).withSelfRel()); }
+            };
+            var memoAssembler = new TripMemoModelAssembler() {
+                @Override public EntityModel<TripMemo> toModel(TripMemo memo) { return EntityModel.of(memo, Link.of("/memos/" + memo.getId()).withSelfRel()); }
+            };
+            var noteController = new TripNoteController(notes, access, noteAssembler, null);
+            var memoController = new TripMemoController(memos, stops, access, memoAssembler, null);
+            var note = new TripNote(null, "x".repeat(4000), null);
+            note.setRequestId(UUID.randomUUID().toString());
+            Long noteId = in(transaction, () -> noteController.newTripNote(trip.getId(), note).getBody().getContent().getId());
+            Long replayed = in(transaction, () -> noteController.newTripNote(trip.getId(), note).getBody().getContent().getId());
+            assertEquals(noteId, replayed);
+            assertEquals(4000, notes.findById(noteId).orElseThrow().getNote().length());
+            assertEquals(404, assertThrows(ResponseStatusException.class, () -> noteController.getTripNoteById(other.getId(), noteId)).getStatusCode().value());
+            var stop = stops.saveAndFlush(new TripLocal(trip.getId(), place.getId(), 1, 1, "Quick note stays separate"));
+            var memo = new TripMemo(trip.getId(), place.getId(), "Anotação da parada", null);
+            memo.setRequestId(UUID.randomUUID().toString());
+            Long memoId = in(transaction, () -> memoController.newTripMemo(memo).getBody().getContent().getId());
+            assertEquals(memoId, in(transaction, () -> memoController.newTripMemo(memo).getBody().getContent().getId()));
+            assertEquals("Quick note stays separate", stops.findById(stop.getId()).orElseThrow().getNote());
+            in(transaction, () -> noteController.updateTripNote(trip.getId(), noteId, new TripNote(null, "Edited", null)));
+            assertEquals("Anotação da parada", memos.findById(memoId).orElseThrow().getNote());
+            assertEquals(1, checklist.list(trip.getId()).size());
+            SecurityContextHolder.getContext().setAuthentication(UsernamePasswordAuthenticationToken.authenticated("nobody@example.invalid", "", List.of()));
+            assertThrows(org.springframework.security.access.AccessDeniedException.class, () -> checklist.list(trip.getId()));
+            assertThrows(org.springframework.security.access.AccessDeniedException.class, () -> noteController.getTripNoteById(trip.getId(), noteId));
+            assertThrows(org.springframework.security.access.AccessDeniedException.class, () -> memoController.getTripMemoById(memoId));
+            SecurityContextHolder.getContext().setAuthentication(UsernamePasswordAuthenticationToken.authenticated(owner.getEmail(), "", List.of()));
+            var tripController = new TripController(trips, users, context.getBean(CityRepository.class), stops, notes, memos,
+                    context.getBean(MediaRepository.class), items, new TripModelAssembler(), null);
+            in(transaction, () -> tripController.deleteTrip(trip.getId()));
+            assertFalse(items.existsById(itemId));
+            assertFalse(notes.existsById(noteId));
+            assertFalse(memos.existsById(memoId));
+            assertFalse(stops.existsById(stop.getId()));
+            assertFalse(trips.existsById(trip.getId()));
+            assertTrue(trips.existsById(other.getId()));
+        } finally { SecurityContextHolder.clearContext(); }
+    }
+
+    private static <T> T in(TransactionTemplate transaction, Supplier<T> action) { return transaction.execute(status -> action.get()); }
+}
